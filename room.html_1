<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, viewport-fit=cover" />
    <!-- Content-Security-Policy removed for development. Uncomment for production: -->
    <!-- <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://*.firebaseio.com https://*.googleapis.com https://*.firebaseapp.com https://*.firebasestorage.app https://www.googleapis.com; img-src 'self' data: https:; frame-src 'self'" /> -->
    <meta name="description" content="SPIKE Elite Chat Room - Premium messaging experience with gifts, stickers, and voice notes" />
    <title>Room — SPIKE Elite</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>💬</text></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet" />
    <style>
        /* ============================================================
           ROOT VARIABLES
           ============================================================ */
        :root {
            --bg-primary: #0a0f16;
            --bg-secondary: #111a24;
            --bg-card: #1a2633;
            --bg-input: #1a2633;
            --bg-bubble-other: #1a2633;
            --bg-bubble-self: #0084ff;
            --bg-header: #0d1520;
            --bg-footer: #0d1520;
            --bg-overlay: rgba(0, 0, 0, 0.7);
            --text-primary: #e8edf4;
            --text-secondary: #8899aa;
            --text-muted: #5a6e8a;
            --text-bubble-self: #ffffff;
            --text-bubble-other: #e8edf4;
            --border-color: #1e2a3a;
            --accent: #0084ff;
            --accent-glow: rgba(0, 132, 255, 0.3);
            --gold: #ffd700;
            --error: #f43f5e;
            --success: #00c853;
            --warning: #f59e0b;
            --online: #00c853;
            --offline: #5a6e8a;
            --premium: #7c3aed;
            --premium-glow: rgba(124, 58, 237, 0.3);
            --elite: #f97316;
            --elite-glow: rgba(249, 115, 22, 0.3);
            --font: 'Inter', system-ui, -apple-system, sans-serif;
            --radius: 12px;
            --shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
            --safe-top: env(safe-area-inset-top, 0px);
            --safe-bottom: env(safe-area-inset-bottom, 0px);
            --transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            --bottom-sheet-radius: 20px;
            --modal-radius: 16px;
            --header-height: 52px;
            --toast-z: 9999;
            --premium-z: 3000;
        }

        /* ============================================================
           RESET & BASE
           ============================================================ */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }
        html,
        body {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background: var(--bg-primary);
            color: var(--text-primary);
            font-family: var(--font);
            font-size: 14px;
        }
        body {
            display: flex;
            flex-direction: column;
            padding-top: var(--safe-top);
            padding-bottom: var(--safe-bottom);
        }

        /* ============================================================
           SCROLLBAR
           ============================================================ */
        .messages-container::-webkit-scrollbar {
            width: 3px;
        }
        .messages-container::-webkit-scrollbar-track {
            background: transparent;
        }
        .messages-container::-webkit-scrollbar-thumb {
            background: var(--border-color);
            border-radius: 10px;
        }
        .messages-container {
            scrollbar-width: thin;
            scrollbar-color: var(--border-color) transparent;
        }

        /* ============================================================
           HEADER
           ============================================================ */
        .room-header {
            background: var(--bg-header);
            border-bottom: 1px solid var(--border-color);
            padding: 0 8px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-shrink: 0;
            min-height: var(--header-height);
            height: var(--header-height);
            gap: 4px;
            position: sticky;
            top: 0;
            z-index: 10;
            overflow: hidden;
        }
        .room-header .left {
            display: flex;
            align-items: center;
            gap: 4px;
            min-width: 0;
            flex: 1 1 0;
            overflow: hidden;
        }
        .room-header .back-btn {
            background: none;
            border: none;
            color: var(--text-secondary);
            font-size: 22px;
            cursor: pointer;
            padding: 0 4px;
            min-height: 36px;
            min-width: 32px;
            border-radius: 8px;
            flex-shrink: 0;
            line-height: 1;
        }
        .room-header .back-btn:active {
            background: rgba(255, 255, 255, 0.05);
        }
        .room-header .room-info {
            display: flex;
            flex-direction: column;
            min-width: 0;
            flex: 1 1 0;
            overflow: hidden;
        }
        .room-header .room-name {
            font-weight: 700;
            font-size: 14px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            line-height: 1.2;
        }
        .room-header .room-name .elite-badge {
            font-size: 7px;
            background: var(--elite);
            color: #fff;
            padding: 0 5px;
            border-radius: 3px;
            font-weight: 800;
            text-transform: uppercase;
            vertical-align: middle;
            margin-left: 2px;
        }
        .room-header .room-meta {
            font-size: 10px;
            color: var(--text-secondary);
            display: flex;
            align-items: center;
            gap: 4px;
            flex-wrap: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .room-header .room-meta .dot {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            display: inline-block;
            flex-shrink: 0;
        }
        .room-header .room-meta .dot.online {
            background: var(--online);
        }
        .room-header .room-meta .dot.offline {
            background: var(--offline);
        }
        .room-header .room-meta .sep {
            opacity: 0.3;
            margin: 0 2px;
        }
        .room-header .right {
            display: flex;
            align-items: center;
            gap: 2px;
            flex-shrink: 0;
            max-width: 70%;
            overflow: hidden;
        }
        .room-header .header-btn {
            background: none;
            border: none;
            color: var(--text-secondary);
            font-size: 16px;
            cursor: pointer;
            padding: 0 4px;
            min-height: 36px;
            min-width: 32px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            line-height: 1;
            flex-shrink: 0;
            transition: background 0.15s;
        }
        .room-header .header-btn:active {
            background: rgba(255, 255, 255, 0.05);
        }
        .room-header .header-btn .badge {
            position: absolute;
            top: 2px;
            right: 1px;
            background: var(--error);
            color: #fff;
            font-size: 7px;
            font-weight: 700;
            width: 14px;
            height: 14px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            line-height: 1;
        }
        .room-header .header-btn .badge-gift {
            position: absolute;
            top: 2px;
            right: 1px;
            background: var(--gold);
            color: #0d1520;
            font-size: 7px;
            font-weight: 700;
            width: 14px;
            height: 14px;
            border-radius: 50%;
            display: none;
            align-items: center;
            justify-content: center;
            line-height: 1;
        }
        .room-header .coins-badge {
            background: rgba(0, 132, 255, 0.12);
            border: 1px solid rgba(0, 132, 255, 0.15);
            border-radius: 20px;
            padding: 0 8px;
            font-size: 11px;
            font-weight: 700;
            color: var(--accent);
            display: flex;
            align-items: center;
            gap: 3px;
            min-height: 28px;
            flex-shrink: 0;
            white-space: nowrap;
        }
        .room-header .coins-badge .coin-icon {
            font-size: 12px;
        }
        .room-header .premium-btn {
            background: linear-gradient(135deg, var(--premium), #6d28d9);
            border: none;
            border-radius: 20px;
            padding: 0 10px;
            font-size: 9px;
            font-weight: 700;
            color: #fff;
            cursor: pointer;
            min-height: 28px;
            box-shadow: 0 0 16px var(--premium-glow);
            flex-shrink: 0;
            white-space: nowrap;
            letter-spacing: 0.3px;
            transition: transform 0.15s;
        }
        .room-header .premium-btn:active {
            transform: scale(0.94);
        }
        .room-header .more-btn {
            background: none;
            border: none;
            color: var(--text-secondary);
            font-size: 18px;
            cursor: pointer;
            padding: 0 4px;
            min-height: 36px;
            min-width: 28px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        .room-header .more-btn:active {
            background: rgba(255, 255, 255, 0.05);
        }

        /* ============================================================
           MORE DROPDOWN
           ============================================================ */
        .header-more-dropdown {
            position: absolute;
            top: calc(var(--header-height) + 4px);
            right: 4px;
            background: var(--bg-secondary);
            border: 1px solid var(--border-color);
            border-radius: var(--radius);
            padding: 4px 0;
            min-width: 160px;
            box-shadow: var(--shadow);
            z-index: 20;
            display: none;
            animation: menuIn 0.15s ease;
        }
        .header-more-dropdown.open {
            display: block;
        }
        .header-more-dropdown .item {
            padding: 8px 14px;
            font-size: 13px;
            font-weight: 500;
            color: var(--text-primary);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            background: none;
            border: none;
            width: 100%;
            font-family: var(--font);
            transition: background 0.12s;
            min-height: 38px;
            text-align: left;
        }
        .header-more-dropdown .item:active {
            background: rgba(255, 255, 255, 0.04);
        }
        .header-more-dropdown .item .icon {
            font-size: 16px;
            width: 24px;
            text-align: center;
            flex-shrink: 0;
        }
        .header-more-dropdown .item .label {
            flex: 1;
        }
        .header-more-dropdown .item .badge-sm {
            background: var(--error);
            color: #fff;
            font-size: 9px;
            font-weight: 700;
            padding: 0 6px;
            border-radius: 10px;
            line-height: 16px;
        }
        .header-more-dropdown .item .badge-sm.gold {
            background: var(--gold);
            color: #0d1520;
        }
        .header-more-dropdown .divider {
            height: 1px;
            background: var(--border-color);
            margin: 4px 8px;
        }

        @keyframes menuIn {
            from {
                opacity: 0;
                transform: scale(0.95) translateY(-4px);
            }
            to {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }

        /* ============================================================
           INFO BAR
           ============================================================ */
        .room-info-bar {
            background: var(--bg-secondary);
            border-bottom: 1px solid var(--border-color);
            padding: 2px 10px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-shrink: 0;
            min-height: 28px;
            font-size: 10px;
            color: var(--text-secondary);
            flex-wrap: nowrap;
            gap: 6px;
            overflow: hidden;
        }
        .room-info-bar .fee {
            color: var(--accent);
            font-weight: 600;
            white-space: nowrap;
        }
        .room-info-bar .members {
            display: flex;
            align-items: center;
            gap: 3px;
            white-space: nowrap;
        }
        .room-info-bar .members .count {
            font-weight: 700;
            color: var(--text-primary);
        }
        .room-info-bar .tier-tags {
            display: flex;
            gap: 4px;
            flex-shrink: 0;
            overflow: hidden;
        }
        .room-info-bar .tier-tag {
            font-weight: 700;
            font-size: 8px;
            padding: 0 6px;
            border-radius: 10px;
            border: 1px solid transparent;
            white-space: nowrap;
            display: none;
        }
        .room-info-bar .tier-tag.vip {
            color: var(--gold);
            border-color: rgba(255, 215, 0, 0.2);
            background: rgba(255, 215, 0, 0.06);
        }
        .room-info-bar .tier-tag.premium {
            color: var(--premium);
            border-color: rgba(124, 58, 237, 0.2);
            background: rgba(124, 58, 237, 0.06);
        }
        .room-info-bar .tier-tag.elite {
            color: var(--elite);
            border-color: rgba(249, 115, 22, 0.2);
            background: rgba(249, 115, 22, 0.06);
        }
        .room-info-bar .tier-tag.show {
            display: inline-block;
        }

        /* ============================================================
           SEARCH BAR
           ============================================================ */
        .search-bar {
            background: var(--bg-secondary);
            border-bottom: 1px solid var(--border-color);
            padding: 4px 10px;
            display: none;
            align-items: center;
            gap: 6px;
            flex-shrink: 0;
            min-height: 36px;
        }
        .search-bar.open {
            display: flex;
        }
        .search-bar input {
            flex: 1;
            background: var(--bg-input);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 4px 12px;
            color: var(--text-primary);
            font-size: 13px;
            font-family: var(--font);
            outline: none;
            min-height: 30px;
        }
        .search-bar input:focus {
            border-color: var(--accent);
        }
        .search-bar .search-close {
            background: none;
            border: none;
            color: var(--text-muted);
            font-size: 18px;
            cursor: pointer;
            min-height: 30px;
            min-width: 30px;
        }

        /* ============================================================
           MESSAGES
           ============================================================ */
        .messages-container {
            flex: 1;
            overflow-y: auto;
            padding: 6px 10px;
            display: flex;
            flex-direction: column;
            gap: 2px;
            scroll-behavior: smooth;
            background: var(--bg-primary);
            -webkit-overflow-scrolling: touch;
        }
        .msg {
            max-width: 88%;
            padding: 5px 10px;
            border-radius: var(--radius);
            animation: msgIn 0.15s ease;
            position: relative;
            word-wrap: break-word;
            margin-bottom: 1px;
            transition: background 0.15s;
            font-size: 13px;
        }
        .msg.other {
            align-self: flex-start;
            background: var(--bg-bubble-other);
            border-bottom-left-radius: 4px;
        }
        .msg.self {
            align-self: flex-end;
            background: var(--bg-bubble-self);
            border-bottom-right-radius: 4px;
            color: var(--text-bubble-self);
        }
        .msg.vip {
            border-left: 3px solid var(--gold);
        }
        .msg.premium {
            border-left: 3px solid var(--premium);
        }
        .msg.elite {
            border-left: 3px solid var(--elite);
        }
        .msg.self.vip {
            border-left: none;
            border-right: 3px solid var(--gold);
        }
        .msg.self.premium {
            border-left: none;
            border-right: 3px solid var(--premium);
        }
        .msg.self.elite {
            border-left: none;
            border-right: 3px solid var(--elite);
        }
        .msg .sender {
            font-size: 10px;
            font-weight: 700;
            color: var(--accent);
            margin-bottom: 1px;
            display: flex;
            align-items: center;
            gap: 3px;
            flex-wrap: wrap;
        }
        .msg.self .sender {
            color: rgba(255, 255, 255, 0.7);
        }
        .msg .sender .crown {
            color: var(--gold);
        }
        .msg .sender .premium-badge-sender {
            color: var(--premium);
            font-size: 7px;
            font-weight: 800;
            background: rgba(124, 58, 237, 0.15);
            padding: 0 4px;
            border-radius: 3px;
        }
        .msg .sender .elite-badge-sender {
            color: var(--elite);
            font-size: 7px;
            font-weight: 800;
            background: rgba(249, 115, 22, 0.15);
            padding: 0 4px;
            border-radius: 3px;
        }
        .msg .sender .mod-tag {
            font-size: 7px;
            background: rgba(0, 132, 255, 0.12);
            padding: 0 4px;
            border-radius: 3px;
            color: var(--accent);
            font-weight: 600;
        }
        .msg .sender .ach-tag {
            font-size: 7px;
            background: rgba(255, 215, 0, 0.1);
            padding: 0 4px;
            border-radius: 3px;
            color: var(--gold);
        }
        .msg .text {
            font-size: 13px;
            line-height: 1.4;
        }
        .msg .text .mention {
            color: var(--accent);
            font-weight: 600;
        }
        .msg .text .hashtag {
            color: var(--gold);
            font-weight: 600;
        }
        .msg .time {
            font-size: 8px;
            color: var(--text-muted);
            margin-top: 2px;
            text-align: right;
            opacity: 0.6;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 4px;
        }
        .msg.self .time {
            color: rgba(255, 255, 255, 0.5);
        }
        .msg .msg-actions {
            display: none;
            gap: 3px;
            margin-top: 2px;
        }
        .msg:hover .msg-actions {
            display: flex;
        }
        .msg .msg-actions button {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--border-color);
            border-radius: 4px;
            padding: 0 5px;
            font-size: 8px;
            color: var(--text-muted);
            cursor: pointer;
            font-family: var(--font);
            transition: var(--transition);
            min-height: 20px;
            line-height: 1;
        }
        .msg .msg-actions button:active {
            transform: scale(0.92);
        }
        .msg .msg-actions button.danger {
            color: var(--error);
        }
        .msg .reactions {
            display: flex;
            gap: 3px;
            flex-wrap: wrap;
            margin-top: 3px;
        }
        .msg .reactions .reaction {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 0 5px;
            font-size: 12px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 2px;
            transition: var(--transition);
            min-height: 20px;
        }
        .msg .reactions .reaction:active {
            transform: scale(0.9);
        }
        .msg .reactions .reaction .r-count {
            font-size: 9px;
            color: var(--text-muted);
        }
        .msg .reactions .reaction.active {
            border-color: var(--accent);
            background: rgba(0, 132, 255, 0.08);
        }
        .msg .reply-preview {
            font-size: 10px;
            color: var(--text-muted);
            padding: 1px 6px;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 6px;
            margin-bottom: 2px;
            border-left: 2px solid var(--accent);
            cursor: pointer;
        }
        .msg .reply-preview .reply-author {
            color: var(--accent);
            font-weight: 600;
        }
        .msg .reply-preview .reply-text {
            opacity: 0.7;
        }
        .msg .msg-image {
            max-width: 100%;
            max-height: 180px;
            border-radius: 8px;
            margin-top: 3px;
            cursor: pointer;
        }
        .msg .voice-msg {
            display: flex;
            align-items: center;
            gap: 6px;
            background: rgba(255, 255, 255, 0.05);
            padding: 3px 8px;
            border-radius: 8px;
            margin-top: 3px;
        }
        .msg .voice-msg button {
            background: none;
            border: none;
            color: var(--text-primary);
            font-size: 16px;
            cursor: pointer;
        }
        .msg .voice-msg .wave {
            flex: 1;
            height: 4px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 4px;
            position: relative;
            overflow: hidden;
        }
        .msg .voice-msg .wave .fill {
            height: 100%;
            background: var(--accent);
            width: 0%;
            border-radius: 4px;
        }
        .msg .voice-msg .duration {
            font-size: 10px;
            color: var(--text-muted);
        }
        .msg .sticker {
            font-size: 40px;
            display: block;
            margin: 2px 0;
        }



        .msg.gift {
            background: rgba(255, 215, 0, 0.04);
            border: 1px solid rgba(255, 215, 0, 0.08);
            text-align: center;
            max-width: 70%;
        }
        .msg.gift .gift-emoji {
            font-size: 24px;
            display: block;
        }
        .msg.gift .gift-label {
            font-size: 10px;
            color: var(--text-secondary);
        }
        .msg.gift .gift-from {
            font-size: 9px;
            color: var(--text-muted);
        }
        .msg .pinned-badge {
            font-size: 8px;
            color: var(--gold);
            background: rgba(255, 215, 0, 0.1);
            padding: 0 5px;
            border-radius: 4px;
            margin-left: 3px;
        }
        .system-msg {
            text-align: center;
            font-size: 10px;
            color: var(--text-muted);
            padding: 3px 0;
            opacity: 0.6;
            font-style: italic;
        }
        @keyframes msgIn {
            from {
                opacity: 0;
                transform: translateY(4px) scale(0.98);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }
        .empty-state {
            text-align: center;
            color: var(--text-muted);
            padding: 30px 16px;
            font-size: 13px;
        }
        .empty-state .icon {
            font-size: 34px;
            display: block;
            margin-bottom: 6px;
        }

        /* ============================================================
           TYPING INDICATOR
           ============================================================ */
        .typing-indicator {
            padding: 2px 12px 4px;
            font-size: 10px;
            color: var(--text-muted);
            font-style: italic;
            display: none;
            flex-shrink: 0;
            min-height: 18px;
        }
        .typing-indicator.active {
            display: block;
        }

        /* ============================================================
           INPUT AREA
           ============================================================ */
        .input-area {
            background: var(--bg-footer);
            border-top: 1px solid var(--border-color);
            padding: 6px 10px;
            display: flex;
            flex-direction: column;
            gap: 4px;
            flex-shrink: 0;
            padding-bottom: calc(6px + var(--safe-bottom));
        }
        .input-area .input-row {
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .input-area .input-wrapper {
            flex: 1;
            display: flex;
            align-items: center;
            background: var(--bg-input);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 0 8px;
            min-height: 36px;
            transition: border-color 0.2s;
            gap: 2px;
            cursor: text;
        }
        .input-area .input-wrapper:focus-within {
            border-color: var(--accent);
        }
        .input-area .input-wrapper input {
            flex: 1;
            background: none;
            border: none;
            outline: none;
            color: var(--text-primary);
            font-size: 13px;
            font-family: var(--font);
            padding: 4px 0;
            min-height: 28px;
            width: 100%;
            cursor: text;
        }
        .input-area .input-wrapper input::placeholder {
            color: var(--text-muted);
            font-size: 12px;
        }
        .input-area .input-wrapper input:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        .input-area .input-wrapper .input-icon {
            color: var(--text-muted);
            font-size: 14px;
            padding: 0 2px;
            cursor: pointer;
            min-height: 28px;
            min-width: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            border-radius: 6px;
            transition: background 0.12s;
            flex-shrink: 0;
        }
        .input-area .input-wrapper .input-icon:active {
            background: rgba(255, 255, 255, 0.04);
        }
        .input-area .input-wrapper .input-icon .lock-overlay {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(0, 0, 0, 0.5);
            border-radius: 6px;
            font-size: 8px;
            color: var(--gold);
            backdrop-filter: blur(2px);
        }
        .input-area .send-btn {
            background: var(--accent);
            border: none;
            border-radius: 50%;
            width: 36px;
            height: 36px;
            min-width: 36px;
            min-height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 16px;
            cursor: pointer;
            transition: all 0.2s;
            flex-shrink: 0;
            box-shadow: 0 0 12px var(--accent-glow);
            position: relative;
        }
        .input-area .send-btn:active {
            transform: scale(0.92);
        }
        .input-area .send-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        .input-area .send-btn .cost-badge {
            position: absolute;
            bottom: -4px;
            right: -4px;
            background: var(--gold);
            color: #0d1520;
            font-size: 7px;
            font-weight: 800;
            padding: 0 4px;
            border-radius: 8px;
            line-height: 14px;
            min-width: 16px;
            text-align: center;
            box-shadow: 0 0 8px rgba(255, 215, 0, 0.3);
        }
        .input-area .cost-indicator {
            text-align: center;
            font-size: 9px;
            color: var(--text-muted);
            opacity: 0.6;
        }
        .input-area .cost-indicator .coin-icon {
            font-size: 10px;
        }

        /* ============================================================
           CENTERED TYPING OVERLAY
           ============================================================ */
        .typing-overlay {
            position: fixed;
            inset: 0;
            background: rgba(10, 15, 22, 0.85);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            z-index: 3000;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
            animation: overlayFadeIn 0.3s ease;
        }
        .typing-overlay.open {
            display: flex;
        }
        @keyframes overlayFadeIn {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }
        .typing-overlay .typing-card {
            max-width: 560px;
            width: 100%;
            background: var(--bg-secondary);
            border: 1px solid var(--border-color);
            border-radius: var(--modal-radius);
            padding: 24px 28px 28px;
            box-shadow: 0 24px 80px rgba(0, 0, 0, 0.9);
            animation: modalSlideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1);
            max-height: 90vh;
            display: flex;
            flex-direction: column;
        }
        @keyframes modalSlideUp {
            from {
                opacity: 0;
                transform: translateY(24px) scale(0.96);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }
        .typing-overlay .typing-card .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
            flex-shrink: 0;
        }
        .typing-overlay .typing-card .card-header .card-title {
            font-size: 0.9rem;
            font-weight: 700;
            color: var(--text-secondary);
            opacity: 0.8;
            letter-spacing: -0.3px;
        }
        .typing-overlay .typing-card .card-header .card-close {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--border-color);
            border-radius: 50%;
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
            cursor: pointer;
            transition: var(--transition);
            font-size: 18px;
            flex-shrink: 0;
        }
        .typing-overlay .typing-card .card-header .card-close:active {
            transform: scale(0.92);
            background: rgba(255, 255, 255, 0.08);
        }
        .typing-overlay .typing-card textarea {
            width: 100%;
            min-height: 160px;
            max-height: 50vh;
            background: var(--bg-input);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 14px 16px;
            color: var(--text-primary);
            font-size: 1rem;
            font-family: var(--font);
            resize: vertical;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
            flex: 1;
            line-height: 1.5;
        }
        .typing-overlay .typing-card textarea:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-glow);
        }
        .typing-overlay .typing-card textarea::placeholder {
            color: var(--text-muted);
            opacity: 0.6;
        }
        .typing-overlay .typing-card .char-count {
            text-align: right;
            font-size: 0.7rem;
            color: var(--text-muted);
            margin-top: 6px;
            opacity: 0.6;
            flex-shrink: 0;
        }
        .typing-overlay .typing-card .input-tools {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: 12px;
            gap: 8px;
            flex-wrap: wrap;
            flex-shrink: 0;
        }
        .typing-overlay .typing-card .input-tools .tool-group {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }
        .typing-overlay .typing-card .input-tools .tool-group button {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 4px 8px;
            font-size: 16px;
            cursor: pointer;
            transition: var(--transition);
            min-height: 40px;
            min-width: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
            position: relative;
            font-family: var(--font);
        }
        .typing-overlay .typing-card .input-tools .tool-group button:active {
            transform: scale(0.92);
            background: rgba(255, 255, 255, 0.06);
        }
        .typing-overlay .typing-card .input-tools .tool-group button .lock-overlay {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(0, 0, 0, 0.5);
            border-radius: 8px;
            font-size: 10px;
            color: var(--gold);
            backdrop-filter: blur(2px);
        }
        .typing-overlay .typing-card .input-tools .send-action {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
        }
        .typing-overlay .typing-card .input-tools .send-action .cost-badge-large {
            font-size: 0.8rem;
            font-weight: 700;
            color: var(--gold);
            background: rgba(255, 215, 0, 0.06);
            padding: 0 10px;
            border-radius: 20px;
            line-height: 32px;
            border: 1px solid rgba(255, 215, 0, 0.1);
        }
        .typing-overlay .typing-card .input-tools .send-action .btn-send-overlay {
            background: var(--accent);
            border: none;
            border-radius: 10px;
            padding: 8px 24px;
            font-weight: 700;
            font-size: 0.9rem;
            color: #fff;
            cursor: pointer;
            transition: var(--transition);
            min-height: 40px;
            box-shadow: 0 0 16px var(--accent-glow);
            font-family: var(--font);
        }
        .typing-overlay .typing-card .input-tools .send-action .btn-send-overlay:active {
            transform: scale(0.95);
        }
        .typing-overlay .typing-card .input-tools .send-action .btn-send-overlay:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        /* ============================================================
           SEND COINS MODAL
           ============================================================ */
        .send-coins-overlay {
            position: fixed;
            inset: 0;
            background: var(--bg-overlay);
            backdrop-filter: blur(8px);
            z-index: 2100;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .send-coins-overlay.open {
            display: flex;
        }
        .send-coins-modal {
            background: var(--bg-secondary);
            border-radius: var(--modal-radius);
            max-width: 420px;
            width: 100%;
            max-height: 85vh;
            overflow-y: auto;
            padding: 20px;
            box-shadow: var(--shadow);
            animation: modalSlideUp 0.3s ease;
            position: relative;
        }
        .send-coins-modal .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }
        .send-coins-modal .modal-header .modal-title {
            font-size: 1.1rem;
            font-weight: 800;
        }
        .send-coins-modal .modal-close {
            background: none;
            border: none;
            color: var(--text-muted);
            font-size: 20px;
            cursor: pointer;
            min-height: 36px;
            min-width: 36px;
        }
        .send-coins-modal .balance-display {
            background: rgba(0, 132, 255, 0.06);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 8px 12px;
            margin-bottom: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .send-coins-modal .balance-display .label {
            font-size: 12px;
            color: var(--text-muted);
        }
        .send-coins-modal .balance-display .amount {
            font-weight: 700;
            font-size: 16px;
            color: var(--accent);
        }
        .send-coins-modal .recipient-select {
            margin-bottom: 10px;
        }
        .send-coins-modal .recipient-select label {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-secondary);
            display: block;
            margin-bottom: 4px;
        }
        .send-coins-modal .recipient-select input,
        .send-coins-modal .recipient-select select {
            width: 100%;
            background: var(--bg-input);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 8px 12px;
            color: var(--text-primary);
            font-size: 14px;
            font-family: var(--font);
            outline: none;
            min-height: 40px;
            transition: border-color 0.2s;
        }
        .send-coins-modal .recipient-select input:focus,
        .send-coins-modal .recipient-select select:focus {
            border-color: var(--accent);
        }
        .send-coins-modal .recipient-select select option {
            background: var(--bg-secondary);
        }
        .send-coins-modal .recipient-select .helper {
            font-size: 10px;
            color: var(--text-muted);
            margin-top: 2px;
        }
        .send-coins-modal .amount-input {
            margin-bottom: 12px;
        }
        .send-coins-modal .amount-input label {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-secondary);
            display: block;
            margin-bottom: 4px;
        }
        .send-coins-modal .amount-input .input-wrap {
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .send-coins-modal .amount-input input {
            flex: 1;
            background: var(--bg-input);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 8px 12px;
            color: var(--text-primary);
            font-size: 16px;
            font-family: var(--font);
            outline: none;
            min-height: 40px;
            width: 100%;
            transition: border-color 0.2s;
        }
        .send-coins-modal .amount-input input:focus {
            border-color: var(--accent);
        }
        .send-coins-modal .amount-input .quick-amounts {
            display: flex;
            gap: 4px;
            margin-top: 4px;
            flex-wrap: wrap;
        }
        .send-coins-modal .amount-input .quick-amounts button {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--border-color);
            border-radius: 6px;
            padding: 2px 10px;
            font-size: 11px;
            font-weight: 600;
            color: var(--text-secondary);
            cursor: pointer;
            font-family: var(--font);
            transition: var(--transition);
            min-height: 28px;
        }
        .send-coins-modal .amount-input .quick-amounts button:active {
            transform: scale(0.92);
            background: rgba(0, 132, 255, 0.08);
        }
        .send-coins-modal .send-actions {
            display: flex;
            gap: 8px;
            margin-top: 4px;
        }
        .send-coins-modal .send-actions button {
            flex: 1;
            padding: 10px;
            border: none;
            border-radius: 10px;
            font-weight: 700;
            font-size: 0.85rem;
            cursor: pointer;
            transition: var(--transition);
            font-family: var(--font);
            min-height: 44px;
        }
        .send-coins-modal .send-actions button:active {
            transform: scale(0.95);
        }
        .send-coins-modal .send-actions .btn-send-coins {
            background: var(--gold);
            color: #0d1520;
        }
        .send-coins-modal .send-actions .btn-send-coins:hover {
            background: #f5c400;
        }
        .send-coins-modal .send-actions .btn-send-coins:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        .send-coins-modal .send-actions .btn-cancel {
            background: rgba(255, 255, 255, 0.04);
            color: var(--text-muted);
            border: 1px solid var(--border-color);
            flex: 0.4;
        }
        .send-coins-modal .send-actions .btn-cancel:hover {
            background: rgba(255, 255, 255, 0.08);
        }
        .send-coins-modal .note {
            font-size: 10px;
            color: var(--text-muted);
            margin-top: 8px;
            text-align: center;
        }

        /* ============================================================
           GIFT SEND MODAL
           ============================================================ */
        .gift-send-overlay {
            position: fixed;
            inset: 0;
            background: var(--bg-overlay);
            backdrop-filter: blur(8px);
            z-index: 2100;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .gift-send-overlay.open {
            display: flex;
        }
        .gift-send-modal {
            background: var(--bg-secondary);
            border-radius: var(--modal-radius);
            max-width: 400px;
            width: 100%;
            max-height: 80vh;
            overflow-y: auto;
            padding: 20px;
            box-shadow: var(--shadow);
            animation: modalSlideUp 0.3s ease;
            position: relative;
        }
        .gift-send-modal .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }
        .gift-send-modal .modal-header .modal-title {
            font-size: 1.1rem;
            font-weight: 800;
        }
        .gift-send-modal .modal-close {
            background: none;
            border: none;
            color: var(--text-muted);
            font-size: 20px;
            cursor: pointer;
            min-height: 36px;
            min-width: 36px;
        }
        .gift-send-modal .recipient-info {
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 6px 10px;
            margin-bottom: 10px;
        }
        .gift-send-modal .recipient-info .avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--accent), #0055aa);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 700;
            color: #fff;
            overflow: hidden;
            flex-shrink: 0;
        }
        .gift-send-modal .recipient-info .avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .gift-send-modal .recipient-info .info {
            flex: 1;
            min-width: 0;
        }
        .gift-send-modal .recipient-info .info .name {
            font-weight: 700;
            font-size: 0.85rem;
        }
        .gift-send-modal .recipient-info .info .spid {
            font-size: 0.65rem;
            color: var(--text-muted);
        }
        .gift-send-modal .recipient-info .info .input-wrap {
            display: flex;
            gap: 4px;
            align-items: center;
        }
        .gift-send-modal .recipient-info .info .input-wrap input {
            flex: 1;
            background: var(--bg-input);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 4px 8px;
            color: var(--text-primary);
            font-size: 12px;
            font-family: var(--font);
            outline: none;
            min-height: 30px;
            min-width: 60px;
        }
        .gift-send-modal .recipient-info .info .input-wrap input:focus {
            border-color: var(--accent);
        }
        .gift-send-modal .recipient-info .info .input-wrap button {
            background: var(--accent);
            border: none;
            border-radius: 8px;
            padding: 0 10px;
            color: #fff;
            font-weight: 700;
            font-size: 11px;
            cursor: pointer;
            font-family: var(--font);
            min-height: 30px;
            flex-shrink: 0;
        }
        .gift-send-modal .gift-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 6px;
            margin: 8px 0;
        }
        .gift-send-modal .gift-grid button {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 6px;
            font-size: 24px;
            cursor: pointer;
            transition: var(--transition);
            min-height: 54px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1px;
            font-family: var(--font);
        }
        .gift-send-modal .gift-grid button:active {
            transform: scale(0.92);
        }
        .gift-send-modal .gift-grid button .gift-cost-popup {
            font-size: 8px;
            color: var(--text-muted);
            font-weight: 600;
        }
        .gift-send-modal .gift-grid button.selected {
            border-color: var(--accent);
            background: rgba(0, 132, 255, 0.08);
        }
        .gift-send-modal .send-actions {
            display: flex;
            gap: 8px;
            margin-top: 4px;
        }
        .gift-send-modal .send-actions button {
            flex: 1;
            padding: 10px;
            border: none;
            border-radius: 10px;
            font-weight: 700;
            font-size: 0.8rem;
            cursor: pointer;
            transition: var(--transition);
            font-family: var(--font);
            min-height: 40px;
        }
        .gift-send-modal .send-actions button:active {
            transform: scale(0.95);
        }
        .gift-send-modal .send-actions .btn-send-gift {
            background: var(--gold);
            color: #0d1520;
        }
        .gift-send-modal .send-actions .btn-send-gift:hover {
            background: #f5c400;
        }
        .gift-send-modal .send-actions .btn-send-gift:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        .gift-send-modal .send-actions .btn-cancel {
            background: rgba(255, 255, 255, 0.04);
            color: var(--text-muted);
            border: 1px solid var(--border-color);
            flex: 0.4;
        }
        .gift-send-modal .send-actions .btn-cancel:hover {
            background: rgba(255, 255, 255, 0.08);
        }

        /* ============================================================
           GIFTS PANEL
           ============================================================ */
        .gifts-panel-overlay {
            position: fixed;
            inset: 0;
            background: var(--bg-overlay);
            backdrop-filter: blur(8px);
            z-index: 2200;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .gifts-panel-overlay.open {
            display: flex;
        }
        .gifts-panel {
            background: var(--bg-secondary);
            border-radius: var(--modal-radius);
            max-width: 480px;
            width: 100%;
            max-height: 85vh;
            overflow-y: auto;
            padding: 20px;
            box-shadow: var(--shadow);
            animation: modalSlideUp 0.3s ease;
            position: relative;
        }
        .gifts-panel .panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 8px;
        }
        .gifts-panel .panel-header .panel-title {
            font-size: 1.05rem;
            font-weight: 800;
        }
        .gifts-panel .panel-header .panel-close {
            background: none;
            border: none;
            color: var(--text-muted);
            font-size: 20px;
            cursor: pointer;
            min-height: 36px;
            min-width: 36px;
        }
        .gifts-panel .gift-list {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
        .gifts-panel .gift-item {
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 6px 10px;
            transition: var(--transition);
        }
        .gifts-panel .gift-item .gift-emoji {
            font-size: 24px;
            width: 36px;
            text-align: center;
            flex-shrink: 0;
        }
        .gifts-panel .gift-item .gift-info {
            flex: 1;
            min-width: 0;
        }
        .gifts-panel .gift-item .gift-info .gift-from {
            font-weight: 700;
            font-size: 0.8rem;
        }
        .gifts-panel .gift-item .gift-info .gift-meta {
            font-size: 0.65rem;
            color: var(--text-muted);
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }
        .gifts-panel .gift-item .gift-info .gift-meta .gift-value {
            color: var(--gold);
            font-weight: 600;
        }
        .gifts-panel .gift-item .gift-actions {
            display: flex;
            gap: 4px;
            flex-shrink: 0;
        }
        .gifts-panel .gift-item .gift-actions button {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--border-color);
            border-radius: 6px;
            padding: 2px 8px;
            font-size: 0.65rem;
            font-weight: 600;
            cursor: pointer;
            color: var(--text-muted);
            min-height: 28px;
            transition: var(--transition);
            font-family: var(--font);
        }
        .gifts-panel .gift-item .gift-actions button:active {
            transform: scale(0.92);
        }
        .gifts-panel .gift-item .gift-actions button.convert {
            color: var(--gold);
            border-color: rgba(255, 215, 0, 0.2);
        }
        .gifts-panel .gift-item .gift-actions button.convert:hover {
            background: rgba(255, 215, 0, 0.08);
        }
        .gifts-panel .gift-item .gift-actions button.converted {
            color: var(--success);
            border-color: rgba(0, 200, 83, 0.2);
            opacity: 0.6;
            cursor: default;
        }
        .gifts-panel .panel-actions {
            margin-top: 10px;
            display: flex;
            gap: 8px;
        }
        .gifts-panel .panel-actions button {
            flex: 1;
            padding: 8px;
            border: none;
            border-radius: 8px;
            font-weight: 700;
            font-size: 0.75rem;
            cursor: pointer;
            transition: var(--transition);
            font-family: var(--font);
            min-height: 36px;
        }
        .gifts-panel .panel-actions button:active {
            transform: scale(0.95);
        }
        .gifts-panel .panel-actions .convert-all {
            background: var(--gold);
            color: #0d1520;
        }
        .gifts-panel .panel-actions .convert-all:hover {
            background: #f5c400;
        }
        .gifts-panel .panel-actions .convert-all:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        .gifts-panel .empty-gifts {
            text-align: center;
            padding: 24px 0;
            color: var(--text-muted);
            font-size: 13px;
        }

        /* ============================================================
           CONTACT ADMIN MODAL
           ============================================================ */
        .contact-modal-overlay {
            position: fixed;
            inset: 0;
            background: var(--bg-overlay);
            backdrop-filter: blur(8px);
            z-index: 2000;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .contact-modal-overlay.open {
            display: flex;
        }
        .contact-modal {
            background: var(--bg-secondary);
            border-radius: var(--modal-radius);
            max-width: 480px;
            width: 100%;
            max-height: 80vh;
            overflow-y: auto;
            padding: 20px;
            box-shadow: var(--shadow);
            animation: modalSlideUp 0.3s ease;
            position: relative;
        }
        .contact-modal .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
        }
        .contact-modal .modal-header .modal-title {
            font-size: 1.05rem;
            font-weight: 800;
        }
        .contact-modal .modal-close {
            background: none;
            border: none;
            color: var(--text-muted);
            font-size: 20px;
            cursor: pointer;
            min-height: 36px;
            min-width: 36px;
        }
        .contact-modal .admin-info {
            background: rgba(0, 132, 255, 0.04);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 8px 12px;
            margin-bottom: 10px;
            display: flex;
            flex-direction: column;
            gap: 2px;
        }
        .contact-modal .admin-info .label {
            font-size: 0.6rem;
            color: var(--text-muted);
            text-transform: uppercase;
            font-weight: 600;
        }
        .contact-modal .admin-info .value {
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 6px;
            word-break: break-all;
        }
        .contact-modal .admin-info .value .copy {
            background: rgba(255, 255, 255, 0.04);
            border: none;
            border-radius: 4px;
            padding: 0 6px;
            font-size: 9px;
            color: var(--text-muted);
            cursor: pointer;
            min-height: 22px;
        }
        .contact-modal .no-spid-note {
            background: rgba(244, 63, 94, 0.08);
            border: 1px solid rgba(244, 63, 94, 0.2);
            border-radius: 8px;
            padding: 6px 10px;
            font-size: 0.75rem;
            color: var(--error);
            margin-bottom: 8px;
            text-align: center;
        }
        .contact-modal .packages-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 5px;
            margin: 6px 0 10px;
        }
        .contact-modal .packages-grid .pkg-btn {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 4px 6px;
            text-align: center;
            cursor: pointer;
            transition: var(--transition);
            font-family: var(--font);
            font-size: 11px;
            color: var(--text-secondary);
            min-height: 44px;
        }
        .contact-modal .packages-grid .pkg-btn:active {
            transform: scale(0.95);
        }
        .contact-modal .packages-grid .pkg-btn.selected {
            border-color: var(--accent);
            background: rgba(0, 132, 255, 0.08);
            color: var(--text-primary);
        }
        .contact-modal .packages-grid .pkg-btn .pkg-amount {
            font-weight: 700;
            font-size: 13px;
            display: block;
            color: var(--gold);
        }
        .contact-modal .packages-grid .pkg-btn .pkg-price {
            font-size: 10px;
        }
        .contact-modal .contact-actions {
            display: flex;
            gap: 8px;
            margin-top: 6px;
        }
        .contact-modal .contact-actions button {
            flex: 1;
            padding: 10px;
            border: none;
            border-radius: 10px;
            font-weight: 700;
            font-size: 0.8rem;
            cursor: pointer;
            transition: var(--transition);
            font-family: var(--font);
            min-height: 40px;
        }
        .contact-modal .contact-actions button:active {
            transform: scale(0.95);
        }
        .contact-modal .contact-actions .btn-whatsapp {
            background: #25D366;
            color: #fff;
        }
        .contact-modal .contact-actions .btn-whatsapp:hover {
            background: #1da851;
        }
        .contact-modal .contact-actions .btn-cancel {
            background: rgba(255, 255, 255, 0.04);
            color: var(--text-muted);
            border: 1px solid var(--border-color);
            flex: 0.4;
        }
        .contact-modal .contact-actions .btn-cancel:hover {
            background: rgba(255, 255, 255, 0.08);
        }

        /* ============================================================
           PREMIUM PANEL — COMPLETE UPGRADE
           ============================================================ */
        .premium-panel-overlay {
            position: fixed;
            inset: 0;
            background: var(--bg-overlay);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            z-index: var(--premium-z);
            display: none;
            align-items: center;
            justify-content: center;
            padding: 16px;
            animation: overlayFadeIn 0.3s ease;
        }
        .premium-panel-overlay.open {
            display: flex;
        }

        .premium-panel {
            background: var(--bg-secondary);
            border: 1px solid var(--border-color);
            border-radius: var(--modal-radius);
            max-width: 560px;
            width: 100%;
            max-height: 92vh;
            overflow-y: auto;
            padding: 0;
            box-shadow: 0 24px 80px rgba(0, 0, 0, 0.9);
            animation: modalSlideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            display: flex;
            flex-direction: column;
        }
        .premium-panel::-webkit-scrollbar {
            width: 3px;
        }
        .premium-panel::-webkit-scrollbar-track {
            background: transparent;
        }
        .premium-panel::-webkit-scrollbar-thumb {
            background: var(--border-color);
            border-radius: 10px;
        }

        .premium-panel .panel-head {
            padding: 16px 20px 10px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-shrink: 0;
            position: sticky;
            top: 0;
            background: var(--bg-secondary);
            z-index: 2;
            border-radius: var(--modal-radius) var(--modal-radius) 0 0;
        }
        .premium-panel .panel-head .title {
            font-size: 1.05rem;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .premium-panel .panel-head .title .badge-tier {
            font-size: 7px;
            font-weight: 700;
            padding: 1px 8px;
            border-radius: 12px;
            background: var(--border-color);
            color: var(--text-secondary);
            text-transform: uppercase;
        }
        .premium-panel .panel-head .title .badge-tier.vip {
            background: rgba(255, 215, 0, 0.15);
            color: var(--gold);
        }
        .premium-panel .panel-head .title .badge-tier.premium {
            background: rgba(124, 58, 237, 0.15);
            color: var(--premium);
        }
        .premium-panel .panel-head .title .badge-tier.elite {
            background: rgba(249, 115, 22, 0.15);
            color: var(--elite);
        }
        .premium-panel .panel-head .close-btn {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--border-color);
            border-radius: 50%;
            width: 34px;
            height: 34px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
            cursor: pointer;
            font-size: 16px;
            transition: var(--transition);
            flex-shrink: 0;
        }
        .premium-panel .panel-head .close-btn:active {
            transform: scale(0.92);
            background: rgba(255, 255, 255, 0.08);
        }

        .premium-panel .panel-body {
            padding: 12px 20px 20px;
            flex: 1;
            overflow-y: auto;
        }

        .premium-panel .tier-status {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 12px 14px;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .premium-panel .tier-status .tier-icon {
            font-size: 32px;
            width: 48px;
            text-align: center;
            flex-shrink: 0;
        }
        .premium-panel .tier-status .tier-info {
            flex: 1;
            min-width: 0;
        }
        .premium-panel .tier-status .tier-info .tier-label {
            font-size: 0.7rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .premium-panel .tier-status .tier-info .tier-name {
            font-size: 1rem;
            font-weight: 800;
        }
        .premium-panel .tier-status .tier-info .tier-name .highlight-vip {
            color: var(--gold);
        }
        .premium-panel .tier-status .tier-info .tier-name .highlight-premium {
            color: var(--premium);
        }
        .premium-panel .tier-status .tier-info .tier-name .highlight-elite {
            color: var(--elite);
        }
        .premium-panel .tier-status .tier-info .tier-desc {
            font-size: 0.7rem;
            color: var(--text-secondary);
            margin-top: 1px;
        }
        .premium-panel .tier-status .tier-badge {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.65rem;
            font-weight: 700;
            flex-shrink: 0;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }
        .premium-panel .tier-status .tier-badge.free {
            background: rgba(255, 255, 255, 0.04);
            color: var(--text-muted);
            border: 1px solid var(--border-color);
        }
        .premium-panel .tier-status .tier-badge.vip {
            background: rgba(255, 215, 0, 0.12);
            color: var(--gold);
            border: 1px solid rgba(255, 215, 0, 0.15);
        }
        .premium-panel .tier-status .tier-badge.premium {
            background: rgba(124, 58, 237, 0.12);
            color: var(--premium);
            border: 1px solid rgba(124, 58, 237, 0.15);
        }
        .premium-panel .tier-status .tier-badge.elite {
            background: rgba(249, 115, 22, 0.12);
            color: var(--elite);
            border: 1px solid rgba(249, 115, 22, 0.15);
        }

        .premium-panel .features-title {
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 6px;
            margin-top: 4px;
        }
        .premium-panel .feature-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6px;
            margin-bottom: 12px;
        }
        .premium-panel .feature-item {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 8px 10px;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: var(--transition);
            position: relative;
            min-height: 44px;
        }
        .premium-panel .feature-item .f-icon {
            font-size: 18px;
            flex-shrink: 0;
            width: 28px;
            text-align: center;
        }
        .premium-panel .feature-item .f-info {
            flex: 1;
            min-width: 0;
        }
        .premium-panel .feature-item .f-info .f-name {
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--text-primary);
        }
        .premium-panel .feature-item .f-info .f-tier {
            font-size: 0.6rem;
            color: var(--text-muted);
            display: block;
            margin-top: 1px;
        }
        .premium-panel .feature-item .f-info .f-tier .tier-tag-sm {
            display: inline-block;
            padding: 0 5px;
            border-radius: 4px;
            font-weight: 700;
            font-size: 0.55rem;
        }
        .premium-panel .feature-item .f-info .f-tier .tier-tag-sm.vip {
            background: rgba(255, 215, 0, 0.1);
            color: var(--gold);
        }
        .premium-panel .feature-item .f-info .f-tier .tier-tag-sm.premium {
            background: rgba(124, 58, 237, 0.1);
            color: var(--premium);
        }
        .premium-panel .feature-item .f-info .f-tier .tier-tag-sm.elite {
            background: rgba(249, 115, 22, 0.1);
            color: var(--elite);
        }
        .premium-panel .feature-item .f-status {
            font-size: 0.7rem;
            font-weight: 700;
            flex-shrink: 0;
            padding: 2px 8px;
            border-radius: 12px;
        }
        .premium-panel .feature-item .f-status.locked {
            color: var(--text-muted);
            background: rgba(255, 255, 255, 0.04);
        }
        .premium-panel .feature-item .f-status.unlocked {
            color: var(--success);
            background: rgba(0, 200, 83, 0.08);
        }
        .premium-panel .feature-item .f-status.premium-only {
            color: var(--premium);
            background: rgba(124, 58, 237, 0.08);
        }
        .premium-panel .feature-item.locked {
            opacity: 0.7;
        }
        .premium-panel .feature-item.locked::after {
            content: '🔒';
            position: absolute;
            top: 4px;
            right: 6px;
            font-size: 10px;
        }
        .premium-panel .feature-item.available {
            border-color: var(--success);
            background: rgba(0, 200, 83, 0.04);
        }

        .premium-panel .upgrade-section {
            margin-top: 4px;
            border-top: 1px solid var(--border-color);
            padding-top: 10px;
        }
        .premium-panel .upgrade-section .upgrade-title {
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 6px;
        }
        .premium-panel .upgrade-buttons {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }
        .premium-panel .upgrade-buttons button {
            flex: 1;
            min-width: 70px;
            padding: 8px 12px;
            border: none;
            border-radius: 10px;
            font-weight: 700;
            font-size: 0.7rem;
            cursor: pointer;
            transition: var(--transition);
            font-family: var(--font);
            min-height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
        }
        .premium-panel .upgrade-buttons button:active {
            transform: scale(0.95);
        }
        .premium-panel .upgrade-buttons .vip-upgrade {
            background: linear-gradient(135deg, var(--gold), #f59e0b);
            color: #0d1520;
        }
        .premium-panel .upgrade-buttons .vip-upgrade:hover {
            box-shadow: 0 0 20px rgba(255, 215, 0, 0.2);
        }
        .premium-panel .upgrade-buttons .premium-upgrade {
            background: linear-gradient(135deg, var(--premium), #6d28d9);
            color: #fff;
            box-shadow: 0 0 16px var(--premium-glow);
        }
        .premium-panel .upgrade-buttons .premium-upgrade:hover {
            box-shadow: 0 0 30px var(--premium-glow);
        }
        .premium-panel .upgrade-buttons .elite-upgrade {
            background: linear-gradient(135deg, var(--elite), #ea580c);
            color: #fff;
            box-shadow: 0 0 16px var(--elite-glow);
        }
        .premium-panel .upgrade-buttons .elite-upgrade:hover {
            box-shadow: 0 0 30px var(--elite-glow);
        }
        .premium-panel .upgrade-buttons button:disabled {
            opacity: 0.4;
            cursor: not-allowed;
            box-shadow: none !important;
        }

        .premium-panel .notif-title {
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-top: 10px;
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .premium-panel .notif-title .clear-btn {
            background: none;
            border: none;
            color: var(--text-muted);
            font-size: 0.6rem;
            cursor: pointer;
            font-family: var(--font);
            padding: 2px 8px;
            border-radius: 6px;
            border: 1px solid var(--border-color);
            transition: var(--transition);
        }
        .premium-panel .notif-title .clear-btn:active {
            transform: scale(0.92);
            background: rgba(255, 255, 255, 0.04);
        }
        .premium-panel .notif-feed {
            display: flex;
            flex-direction: column;
            gap: 4px;
            max-height: 180px;
            overflow-y: auto;
            padding-right: 4px;
        }
        .premium-panel .notif-feed::-webkit-scrollbar {
            width: 2px;
        }
        .premium-panel .notif-feed::-webkit-scrollbar-thumb {
            background: var(--border-color);
            border-radius: 10px;
        }
        .premium-panel .notif-item {
            font-size: 0.7rem;
            color: var(--text-secondary);
            padding: 4px 8px;
            background: rgba(255, 255, 255, 0.02);
            border-radius: 6px;
            border-left: 2px solid var(--border-color);
            display: flex;
            align-items: center;
            gap: 6px;
            animation: notifSlide 0.25s ease;
            min-height: 28px;
        }
        @keyframes notifSlide {
            from {
                opacity: 0;
                transform: translateX(-8px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }
        .premium-panel .notif-item .n-icon {
            font-size: 14px;
            flex-shrink: 0;
        }
        .premium-panel .notif-item .n-text {
            flex: 1;
            word-break: break-word;
        }
        .premium-panel .notif-item .n-time {
            font-size: 0.55rem;
            color: var(--text-muted);
            flex-shrink: 0;
            opacity: 0.6;
        }
        .premium-panel .notif-item.success {
            border-left-color: var(--success);
        }
        .premium-panel .notif-item.error {
            border-left-color: var(--error);
        }
        .premium-panel .notif-item.warning {
            border-left-color: var(--warning);
        }
        .premium-panel .notif-item.info {
            border-left-color: var(--accent);
        }
        .premium-panel .notif-item.premium {
            border-left-color: var(--premium);
        }
        .premium-panel .notif-item.elite {
            border-left-color: var(--elite);
        }
        .premium-panel .notif-item.gold {
            border-left-color: var(--gold);
        }
        .premium-panel .notif-empty {
            text-align: center;
            color: var(--text-muted);
            font-size: 0.7rem;
            padding: 12px 0;
            opacity: 0.6;
        }

        /* ============================================================
           TOAST — FIXED & RELIABLE
           ============================================================ */
        .toast-container {
            position: fixed;
            top: 16px;
            left: 50%;
            transform: translateX(-50%) translateY(-120px);
            z-index: var(--toast-z);
            width: calc(100% - 32px);
            max-width: 380px;
            opacity: 0;
            visibility: hidden;
            transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
            pointer-events: none;
        }
        .toast-container.active {
            opacity: 1;
            visibility: visible;
            transform: translateX(-50%) translateY(0);
            pointer-events: auto;
        }
        .toast-container.removing {
            opacity: 0;
            transform: translateX(-50%) translateY(-40px);
        }
        .toast-content {
            background: var(--bg-secondary);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid var(--border-color);
            border-radius: 14px;
            padding: 10px 14px;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            box-shadow: 0 16px 48px rgba(0, 0, 0, 0.7);
            animation: toastSlideIn 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            overflow: hidden;
        }
        @keyframes toastSlideIn {
            from {
                opacity: 0;
                transform: translateY(-16px) scale(0.95);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }
        .toast-content .toast-icon-wrapper {
            width: 30px;
            height: 30px;
            min-width: 30px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
            flex-shrink: 0;
        }
        .toast-content .toast-icon-wrapper.success {
            background: rgba(0, 200, 83, 0.12);
            color: var(--success);
        }
        .toast-content .toast-icon-wrapper.error {
            background: rgba(244, 63, 94, 0.12);
            color: var(--error);
        }
        .toast-content .toast-icon-wrapper.warning {
            background: rgba(245, 158, 11, 0.12);
            color: var(--warning);
        }
        .toast-content .toast-icon-wrapper.info {
            background: rgba(0, 132, 255, 0.12);
            color: var(--accent);
        }
        .toast-content .toast-icon-wrapper.premium {
            background: rgba(124, 58, 237, 0.12);
            color: var(--premium);
        }
        .toast-content .toast-icon-wrapper.elite {
            background: rgba(249, 115, 22, 0.12);
            color: var(--elite);
        }
        .toast-content .toast-icon-wrapper.gold {
            background: rgba(255, 215, 0, 0.12);
            color: var(--gold);
        }
        .toast-content .toast-body {
            flex: 1;
            min-width: 0;
        }
        .toast-content .toast-title {
            font-size: 13px;
            font-weight: 800;
            color: var(--text-primary);
            letter-spacing: -0.2px;
            line-height: 1.2;
        }
        .toast-content .toast-message {
            font-size: 11px;
            font-weight: 500;
            color: var(--text-secondary);
            line-height: 1.3;
            margin-top: 1px;
        }
        .toast-content .toast-close {
            background: rgba(255, 255, 255, 0.04);
            border: none;
            border-radius: 50%;
            width: 22px;
            height: 22px;
            min-width: 22px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
            cursor: pointer;
            font-size: 12px;
            transition: var(--transition);
            flex-shrink: 0;
        }
        .toast-content .toast-close:active {
            transform: scale(0.9);
        }
        .toast-progress {
            position: absolute;
            bottom: 0;
            left: 0;
            height: 2px;
            border-radius: 0 0 14px 14px;
            width: 100%;
            animation: toastProgress 3.5s linear forwards;
        }
        .toast-progress.success {
            background: var(--success);
        }
        .toast-progress.error {
            background: var(--error);
        }
        .toast-progress.warning {
            background: var(--warning);
        }
        .toast-progress.info {
            background: var(--accent);
        }
        .toast-progress.premium {
            background: var(--premium);
        }
        .toast-progress.elite {
            background: var(--elite);
        }
        .toast-progress.gold {
            background: var(--gold);
        }
        @keyframes toastProgress {
            0% {
                width: 100%;
            }
            100% {
                width: 0%;
            }
        }

        /* ============================================================
           CONFIRM MODAL
           ============================================================ */
        .confirm-overlay {
            position: fixed;
            inset: 0;
            background: var(--bg-overlay);
            backdrop-filter: blur(4px);
            z-index: 10000;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .confirm-overlay.active {
            display: flex;
        }
        .confirm-modal {
            background: var(--bg-secondary);
            border: 1px solid var(--border-color);
            border-radius: var(--radius);
            padding: 16px 14px;
            max-width: 320px;
            width: 100%;
            box-shadow: var(--shadow);
            text-align: center;
        }
        .confirm-modal .icon {
            font-size: 30px;
            margin-bottom: 4px;
        }
        .confirm-modal .title {
            font-weight: 700;
            font-size: 15px;
            margin-bottom: 3px;
        }
        .confirm-modal .message {
            font-size: 12px;
            color: var(--text-secondary);
            margin-bottom: 10px;
            line-height: 1.4;
        }
        .confirm-modal .actions {
            display: flex;
            gap: 6px;
        }
        .confirm-modal .actions button {
            flex: 1;
            padding: 8px;
            border-radius: 10px;
            border: none;
            font-weight: 700;
            font-size: 13px;
            cursor: pointer;
            font-family: var(--font);
            transition: all 0.2s;
            min-height: 36px;
        }
        .confirm-modal .actions button:active {
            transform: scale(0.95);
        }
        .confirm-modal .actions .cancel {
            background: rgba(255, 255, 255, 0.04);
            color: var(--text-secondary);
            border: 1px solid var(--border-color);
        }
        .confirm-modal .actions .danger {
            background: var(--error);
            color: #fff;
        }
        .confirm-modal .actions .primary {
            background: var(--accent);
            color: #fff;
        }
        .confirm-modal .actions .premium {
            background: var(--premium);
            color: #fff;
        }

        /* ============================================================
           GIFT RAIN
           ============================================================ */
        .gift-rain {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 100;
            overflow: hidden;
        }
        .gift-rain .drop {
            position: absolute;
            font-size: 24px;
            animation: rainFall linear forwards;
        }
        @keyframes rainFall {
            0% {
                transform: translateY(-10vh) rotate(0deg) scale(0.5);
                opacity: 1;
            }
            100% {
                transform: translateY(110vh) rotate(720deg) scale(1.2);
                opacity: 0;
            }
        }

        /* ============================================================
           STICKER PICKER
           ============================================================ */
        .sticker-picker-overlay {
            position: fixed;
            inset: 0;
            background: var(--bg-overlay);
            backdrop-filter: blur(8px);
            z-index: 850;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .sticker-picker-overlay.open {
            display: flex;
        }
        .sticker-picker {
            background: var(--bg-secondary);
            border-radius: var(--radius);
            padding: 14px;
            max-width: 380px;
            width: 100%;
            max-height: 70vh;
            overflow-y: auto;
            box-shadow: var(--shadow);
            animation: modalSlideUp 0.3s ease;
        }
        .sticker-picker .sticker-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }
        .sticker-picker .sticker-header .sticker-title {
            font-weight: 700;
            font-size: 13px;
        }
        .sticker-picker .sticker-categories {
            display: flex;
            gap: 3px;
            margin-bottom: 6px;
            flex-wrap: wrap;
        }
        .sticker-picker .sticker-categories button {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--border-color);
            border-radius: 6px;
            padding: 1px 8px;
            font-size: 10px;
            color: var(--text-muted);
            cursor: pointer;
            font-family: var(--font);
            transition: var(--transition);
            min-height: 26px;
        }
        .sticker-picker .sticker-categories button.active {
            border-color: var(--accent);
            color: var(--text-primary);
            background: rgba(0, 132, 255, 0.08);
        }
        .sticker-picker .sticker-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 4px;
        }
        .sticker-picker .sticker-grid button {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 4px;
            font-size: 24px;
            cursor: pointer;
            transition: var(--transition);
            min-height: 48px;
        }
        .sticker-picker .sticker-grid button:active {
            transform: scale(0.9);
        }
        .sticker-picker .sticker-close {
            background: none;
            border: none;
            color: var(--text-muted);
            font-size: 18px;
            cursor: pointer;
            min-height: 32px;
            min-width: 32px;
        }

        /* ============================================================
           REACTION PICKER
           ============================================================ */
        .reaction-picker-overlay {
            position: fixed;
            inset: 0;
            background: var(--bg-overlay);
            backdrop-filter: blur(4px);
            z-index: 800;
            display: none;
            align-items: center;
            justify-content: center;
        }
        .reaction-picker-overlay.open {
            display: flex;
        }
        .reaction-picker {
            background: var(--bg-secondary);
            border-radius: var(--radius);
            padding: 10px 14px;
            box-shadow: var(--shadow);
            animation: modalSlideUp 0.2s ease;
        }
        .reaction-picker .reaction-grid {
            display: flex;
            gap: 4px;
            flex-wrap: wrap;
            justify-content: center;
        }
        .reaction-picker .reaction-grid button {
            background: none;
            border: none;
            font-size: 24px;
            cursor: pointer;
            padding: 2px 6px;
            border-radius: 8px;
            transition: var(--transition);
            min-height: 38px;
            min-width: 38px;
        }
        .reaction-picker .reaction-grid button:active {
            transform: scale(0.85);
            background: rgba(255, 255, 255, 0.05);
        }

        /* ============================================================
           PARTICIPANTS PANEL
           ============================================================ */
        .participants-overlay {
            position: fixed;
            inset: 0;
            background: var(--bg-overlay);
            backdrop-filter: blur(4px);
            z-index: 50;
            display: none;
        }
        .participants-overlay.open {
            display: block;
        }
        .participants-panel {
            position: fixed;
            right: 0;
            top: 0;
            bottom: 0;
            width: 270px;
            max-width: 82vw;
            background: var(--bg-secondary);
            border-left: 1px solid var(--border-color);
            padding: 14px 10px;
            transform: translateX(100%);
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            z-index: 51;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .participants-panel.open {
            transform: translateX(0);
        }
        .participants-panel .panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 6px;
            border-bottom: 1px solid var(--border-color);
            flex-shrink: 0;
        }
        .participants-panel .panel-header .title {
            font-weight: 700;
            font-size: 13px;
        }
        .participants-panel .panel-header .close-btn {
            background: none;
            border: none;
            color: var(--text-muted);
            font-size: 18px;
            cursor: pointer;
            min-height: 32px;
            min-width: 32px;
        }
        .participants-panel .participant {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 4px 6px;
            border-radius: 8px;
            transition: background 0.2s;
            cursor: pointer;
            min-height: 34px;
        }
        .participants-panel .participant:active {
            background: rgba(255, 255, 255, 0.04);
        }
        .participants-panel .participant .avatar {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--accent), #0055aa);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            font-weight: 700;
            color: #fff;
            flex-shrink: 0;
            overflow: hidden;
        }
        .participants-panel .participant .avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .participants-panel .participant .info {
            flex: 1;
            min-width: 0;
        }
        .participants-panel .participant .info .name {
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .participants-panel .participant .info .name .crown {
            color: var(--gold);
        }
        .participants-panel .participant .info .name .premium-badge-p {
            color: var(--premium);
            font-size: 7px;
            font-weight: 800;
        }
        .participants-panel .participant .info .name .elite-badge-p {
            color: var(--elite);
            font-size: 7px;
            font-weight: 800;
        }
        .participants-panel .participant .info .name .signal-badge {
            display: inline-block;
            font-size: 7px;
            background: rgba(255, 215, 0, 0.12);
            color: var(--gold);
            padding: 0 5px;
            border-radius: 10px;
            font-weight: 700;
            margin-left: 2px;
        }
        .participants-panel .participant .info .name .mod-badge {
            font-size: 8px;
            background: rgba(0, 132, 255, 0.1);
            padding: 0 4px;
            border-radius: 3px;
            color: var(--accent);
            font-weight: 600;
        }
        .participants-panel .participant .info .status {
            font-size: 9px;
            color: var(--text-muted);
        }
        .participants-panel .participant .info .status .online-dot {
            display: inline-block;
            width: 5px;
            height: 5px;
            border-radius: 50%;
            margin-right: 3px;
        }
        .participants-panel .participant .info .status .online-dot.on {
            background: var(--online);
        }
        .participants-panel .participant .info .status .online-dot.off {
            background: var(--offline);
        }
        .participants-panel .empty-participants {
            text-align: center;
            color: var(--text-muted);
            padding: 16px 0;
            font-size: 12px;
        }

        /* ============================================================
           PROFILE MODAL
           ============================================================ */
        .profile-modal-overlay {
            position: fixed;
            inset: 0;
            background: var(--bg-overlay);
            backdrop-filter: blur(8px);
            z-index: 9000;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .profile-modal-overlay.open {
            display: flex;
        }
        .profile-modal {
            background: var(--bg-secondary);
            border-radius: var(--modal-radius);
            max-width: 460px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            padding: 20px;
            box-shadow: var(--shadow);
            animation: modalSlideUp 0.3s ease;
            position: relative;
        }
        .profile-modal .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 8px;
        }
        .profile-modal .modal-header .modal-title {
            font-size: 1rem;
            font-weight: 800;
        }
        .profile-modal .modal-header .modal-close {
            background: none;
            border: none;
            color: var(--text-muted);
            font-size: 18px;
            cursor: pointer;
            min-height: 32px;
            min-width: 32px;
        }
        .profile-modal .profile-avatar {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--accent), #0055aa);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            font-weight: 700;
            color: #fff;
            overflow: hidden;
            margin: 0 auto 6px;
        }
        .profile-modal .profile-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .profile-modal .profile-name {
            font-size: 1rem;
            font-weight: 700;
            text-align: center;
        }
        .profile-modal .profile-spid {
            font-size: 0.75rem;
            color: var(--text-muted);
            text-align: center;
        }
        .profile-modal .profile-signal {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            margin: 6px 0;
            font-size: 0.8rem;
            color: var(--gold);
            background: rgba(255, 215, 0, 0.06);
            padding: 4px 12px;
            border-radius: 20px;
            border: 1px solid rgba(255, 215, 0, 0.12);
        }
        .profile-modal .profile-signal .signal-amount {
            font-weight: 700;
            font-size: 1rem;
        }
        .profile-modal .profile-actions {
            display: flex;
            gap: 6px;
            margin-top: 10px;
            flex-wrap: wrap;
        }
        .profile-modal .profile-actions button {
            flex: 1;
            padding: 6px 10px;
            border: none;
            border-radius: 10px;
            font-weight: 700;
            font-size: 0.75rem;
            cursor: pointer;
            transition: var(--transition);
            font-family: var(--font);
            min-height: 36px;
            min-width: 60px;
        }
        .profile-modal .profile-actions button:active {
            transform: scale(0.95);
        }
        .profile-modal .profile-actions .btn-send-coins {
            background: var(--gold);
            color: #0d1520;
        }
        .profile-modal .profile-actions .btn-send-coins:hover {
            background: #f5c400;
        }
        .profile-modal .profile-actions .btn-send-gift {
            background: var(--accent);
            color: #fff;
            box-shadow: 0 0 12px var(--accent-glow);
        }
        .profile-modal .profile-actions .btn-send-gift:hover {
            background: #0099ff;
        }
        .profile-modal .profile-actions .btn-message {
            background: rgba(255, 255, 255, 0.04);
            color: var(--text-primary);
            border: 1px solid var(--border-color);
        }
        .profile-modal .profile-actions .btn-message:hover {
            background: rgba(255, 255, 255, 0.08);
        }
        .profile-modal .profile-actions .btn-close {
            background: rgba(255, 255, 255, 0.04);
            color: var(--text-muted);
            border: 1px solid var(--border-color);
            flex: 0.3;
        }
        .profile-modal .profile-actions .btn-close:hover {
            background: rgba(255, 255, 255, 0.08);
        }

        /* ============================================================
           USER MENU
           ============================================================ */
        .user-menu-overlay {
            position: fixed;
            inset: 0;
            z-index: 8000;
            display: none;
        }
        .user-menu-overlay.active {
            display: block;
        }
        .user-menu {
            position: fixed;
            background: var(--bg-secondary);
            border: 1px solid var(--border-color);
            border-radius: var(--radius);
            padding: 3px 0;
            min-width: 150px;
            box-shadow: var(--shadow);
            z-index: 8001;
            animation: menuIn 0.15s ease;
        }
        .user-menu .item {
            padding: 6px 12px;
            font-size: 12px;
            font-weight: 500;
            color: var(--text-primary);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: background 0.12s;
            border: none;
            background: none;
            width: 100%;
            font-family: var(--font);
            min-height: 34px;
        }
        .user-menu .item:active {
            background: rgba(255, 255, 255, 0.04);
        }
        .user-menu .item.danger {
            color: var(--error);
        }
        .user-menu .item .icon {
            font-size: 14px;
            width: 20px;
            text-align: center;
        }

        /* ============================================================
           RESPONSIVE
           ============================================================ */
        @media (max-width: 374px) {
            body {
                font-size: 12px;
            }
            :root {
                --header-height: 46px;
            }
            .room-header .room-name {
                font-size: 12px;
            }
            .room-header .room-meta {
                font-size: 9px;
            }
            .room-header .coins-badge {
                font-size: 9px;
                padding: 0 5px;
                min-height: 24px;
            }
            .room-header .premium-btn {
                font-size: 7px;
                padding: 0 6px;
                min-height: 24px;
            }
            .room-header .header-btn {
                font-size: 14px;
                min-height: 30px;
                min-width: 26px;
            }
            .room-header .back-btn {
                font-size: 18px;
                min-height: 30px;
                min-width: 26px;
            }
            .msg {
                font-size: 12px;
                padding: 4px 8px;
                max-width: 92%;
            }
            .msg .text {
                font-size: 12px;
            }
            .input-area .input-wrapper {
                min-height: 32px;
            }
            .input-area .input-wrapper input {
                font-size: 12px;
            }
            .input-area .send-btn {
                width: 32px;
                height: 32px;
                min-width: 32px;
                min-height: 32px;
                font-size: 14px;
            }
            .participants-panel {
                width: 220px;
                padding: 10px 6px;
            }
            .gift-send-modal .gift-grid {
                grid-template-columns: repeat(3, 1fr);
            }
            .sticker-picker .sticker-grid {
                grid-template-columns: repeat(4, 1fr);
            }
            .contact-modal .packages-grid {
                grid-template-columns: 1fr 1fr;
            }
            .send-coins-modal {
                padding: 16px;
            }
            .profile-modal {
                padding: 16px;
            }
            .typing-overlay .typing-card {
                padding: 16px;
            }
            .typing-overlay .typing-card textarea {
                min-height: 120px;
            }
            .premium-panel .feature-grid {
                grid-template-columns: 1fr 1fr;
            }
            .premium-panel .upgrade-buttons button {
                font-size: 0.6rem;
                min-width: 60px;
                padding: 6px 8px;
            }
        }
        @media (min-width: 375px) and (max-width: 480px) {
            .room-header .room-name {
                font-size: 13px;
            }
            .room-header .room-meta {
                font-size: 9px;
            }
            .room-header .coins-badge {
                font-size: 10px;
                padding: 0 6px;
                min-height: 26px;
            }
            .room-header .premium-btn {
                font-size: 8px;
                padding: 0 8px;
                min-height: 26px;
            }
            .msg {
                padding: 4px 10px;
                max-width: 88%;
            }
            .input-area {
                padding: 4px 8px;
            }
            .gift-send-modal .gift-grid {
                grid-template-columns: repeat(4, 1fr);
            }
            .contact-modal .packages-grid {
                grid-template-columns: 1fr 1fr;
            }
            .typing-overlay .typing-card {
                padding: 18px;
            }
            .typing-overlay .typing-card textarea {
                min-height: 140px;
            }
            .premium-panel .feature-grid {
                grid-template-columns: 1fr 1fr;
            }
            .premium-panel .upgrade-buttons button {
                font-size: 0.65rem;
            }
        }
        @media (min-width: 481px) {
            .messages-container {
                padding: 8px 20px;
            }
            .room-header {
                padding: 0 16px;
            }
            .input-area {
                padding: 6px 20px;
            }
            .msg {
                max-width: 72%;
            }
            .gift-send-modal .gift-grid {
                grid-template-columns: repeat(4, 1fr);
            }
            .send-coins-modal .amount-input .quick-amounts button {
                padding: 2px 14px;
            }
            .contact-modal .packages-grid {
                grid-template-columns: repeat(3, 1fr);
            }
            .typing-overlay .typing-card {
                padding: 28px 32px 32px;
            }
            .typing-overlay .typing-card textarea {
                min-height: 180px;
            }
            .premium-panel .feature-grid {
                grid-template-columns: 1fr 1fr;
            }
        }
        @media (pointer: coarse) {
            .back-btn,
            .header-btn,
            .send-btn,
            .participant,
            .confirm-modal .actions button,
            .user-menu .item,
            .toast-close,
            .premium-btn,
            .gift-send-modal .modal-close,
            .gift-send-modal .gift-grid button,
            .gift-send-modal .send-actions button,
            .gifts-panel .panel-close,
            .gifts-panel .gift-item .gift-actions button,
            .gifts-panel .panel-actions button,
            .sticker-picker .sticker-grid button,
            .sticker-picker .sticker-close,
            .reaction-picker .reaction-grid button,
            .search-close,
            .input-area .input-wrapper .input-icon,
            .contact-modal .modal-close,
            .contact-modal .contact-actions button,
            .contact-modal .packages-grid .pkg-btn,
            .profile-modal .modal-close,
            .profile-modal .profile-actions button,
            .send-coins-modal .modal-close,
            .send-coins-modal .send-actions button,
            .send-coins-modal .amount-input .quick-amounts button,
            .send-coins-modal .recipient-select input,
            .send-coins-modal .recipient-select select,
            .send-coins-modal .amount-input input,
            .header-more-dropdown .item,
            .more-btn,
            .typing-overlay .typing-card .card-close,
            .typing-overlay .typing-card .input-tools .tool-group button,
            .typing-overlay .typing-card .input-tools .send-action .btn-send-overlay,
            .premium-panel .panel-head .close-btn,
            .premium-panel .upgrade-buttons button,
            .premium-panel .notif-title .clear-btn {
                min-height: 44px;
                min-width: 44px;
            }
            .participant {
                min-height: 38px;
            }
            .input-area .input-wrapper .input-icon {
                min-height: 34px;
                min-width: 34px;
            }
            .room-header .header-btn {
                min-height: 36px;
                min-width: 32px;
            }
            .typing-overlay .typing-card textarea {
                font-size: 16px;
            }
            .premium-panel .upgrade-buttons button {
                min-height: 44px;
            }
        }
    </style>
</head>
<body>

    <!-- ============================================================
    HEADER
    ============================================================ -->
    <header class="room-header" id="roomHeader">
        <div class="left">
            <button class="back-btn" onclick="window.location.href='rooms.html'" aria-label="Back">‹</button>
            <div class="room-info">
                <div class="room-name" id="roomName">Loading… <span class="elite-badge">ELITE</span></div>
                <div class="room-meta">
                    <span id="roomMembers">👥 0</span>
                    <span class="sep">·</span>
                    <span class="dot online" id="roomStatusDot"></span>
                    <span id="roomStatusText">online</span>
                </div>
            </div>
        </div>

        <div class="right" id="headerRight">
            <span class="coins-badge" id="coinsBadge">
                <span class="coin-icon">🪙</span>
                <span id="headerCoins">0</span>
            </span>

            <button class="header-btn" onclick="openSendCoinsModal()" title="Send Coins" aria-label="Send Coins">
                💸
            </button>

            <button class="header-btn" id="giftsBtn" onclick="openGiftsPanel()" title="My Gifts" aria-label="My Gifts">
                🎁
                <span class="badge-gift" id="giftBadge">0</span>
            </button>

            <button class="header-btn" onclick="toggleSearch()" title="Search" aria-label="Search">🔍</button>

            <button class="premium-btn" onclick="openPremiumPanel()" id="premiumBtn">⭐ ELITE</button>

            <button class="header-btn" onclick="toggleParticipants()" title="Members" aria-label="Members">
                👥
                <span class="badge" id="memberBadge">0</span>
            </button>

            <button class="more-btn" id="moreBtn" onclick="toggleMoreDropdown()" aria-label="More">⋯</button>

            <div class="header-more-dropdown" id="moreDropdown">
                <button class="item" onclick="openSendCoinsModal(); closeMoreDropdown();">
                    <span class="icon">💸</span>
                    <span class="label">Send Coins</span>
                </button>
                <button class="item" onclick="openGiftSendModal(); closeMoreDropdown();">
                    <span class="icon">😊</span>
                    <span class="label">Send Gift</span>
                </button>
                <button class="item" onclick="window.location.href='shop.html'; closeMoreDropdown();">
                    <span class="icon">🪙</span>
                    <span class="label">Shop</span>
                </button>
                <button class="item" onclick="openContactModal(); closeMoreDropdown();">
                    <span class="icon">📞</span>
                    <span class="label">Contact Admin</span>
                </button>
                <div class="divider"></div>
                <button class="item" onclick="openGiftsPanel(); closeMoreDropdown();">
                    <span class="icon">🎁</span>
                    <span class="label">My Gifts</span>
                    <span class="badge-sm gold" id="moreGiftBadge" style="display:none;">0</span>
                </button>
                <button class="item" onclick="toggleParticipants(); closeMoreDropdown();">
                    <span class="icon">👥</span>
                    <span class="label">Members</span>
                    <span class="badge-sm" id="moreMemberBadge">0</span>
                </button>
                <button class="item" onclick="openPremiumPanel(); closeMoreDropdown();">
                    <span class="icon">⭐</span>
                    <span class="label">Premium</span>
                </button>
            </div>
        </div>
    </header>

    <!-- ============================================================
    INFO BAR
    ============================================================ -->
    <div class="room-info-bar">
        <span class="fee" id="roomFee">Entry: 🪙 50</span>
        <span class="members">👥 <span class="count" id="memberCount">0</span> online</span>
        <div class="tier-tags">
            <span class="tier-tag vip" id="vipTag">👑 VIP</span>
            <span class="tier-tag premium" id="premiumTag">⭐ PREMIUM</span>
            <span class="tier-tag elite" id="eliteTag">🔥 ELITE</span>
        </div>
    </div>

    <!-- ============================================================
    SEARCH BAR
    ============================================================ -->
    <div class="search-bar" id="searchBar">
        <input type="text" id="searchInput" placeholder="Search messages…" oninput="performSearch(this.value)" />
        <button class="search-close" onclick="toggleSearch()">✕</button>
    </div>

    <!-- ============================================================
    MESSAGES
    ============================================================ -->
    <div class="messages-container" id="messagesContainer">
        <div class="empty-state"><span class="icon">💬</span>No messages yet.<br />Say hello!</div>
    </div>

    <!-- ============================================================
    TYPING INDICATOR
    ============================================================ -->
    <div class="typing-indicator" id="typingIndicator">Someone is typing…</div>

    <!-- ============================================================
    BOTTOM INPUT AREA
    ============================================================ -->
    <div class="input-area" id="bottomInputArea">
        <div class="input-row">
            <div class="input-wrapper" id="inputWrapper">
                <span class="input-icon" id="stickerBtn" onclick="toggleStickerPicker()" title="Stickers (2🪙)">
                    😊
                    <span class="lock-overlay" id="stickerLock" style="display:none;">🔒</span>
                </span>
                <span class="input-icon" id="voiceBtn" onclick="toggleVoiceRecorder()" title="Voice Note (3🪙)">
                    🎤
                    <span class="lock-overlay" id="voiceLock" style="display:none;">🔒</span>
                </span>
                <span class="input-icon" id="imageBtn" onclick="triggerImageUpload()" title="Image (5🪙)">
                    🖼️
                    <span class="lock-overlay" id="imageLock" style="display:none;">🔒</span>
                </span>

                <input type="text" id="msgInput" placeholder="Type a message… (1🪙)" onkeydown="if(event.key==='Enter') sendMessage()" disabled />
                <span class="input-icon" id="atBtn" onclick="insertMention()" style="font-size:11px;font-weight:700;">@</span>
            </div>
            <button class="send-btn" id="sendBtn" onclick="sendMessage()" disabled>
                ➤
                <span class="cost-badge" id="msgCostBadge">1</span>
            </button>
        </div>
        <div class="cost-indicator">
            <span class="coin-icon">🪙</span> Text: 1 &nbsp;|&nbsp; Sticker: 2 &nbsp;|&nbsp; Voice: 3 &nbsp;|&nbsp; Image: 5
        </div>
    </div>

    <!-- ============================================================
    CENTERED TYPING OVERLAY
    ============================================================ -->
    <div class="typing-overlay" id="typingOverlay">
        <div class="typing-card">
            <div class="card-header">
                <span class="card-title">✏️ Compose message</span>
                <button class="card-close" onclick="closeTypingOverlay()">✕</button>
            </div>
            <textarea id="typingTextarea" placeholder="What's on your mind?" rows="4"></textarea>
            <div class="char-count"><span id="charCount">0</span> characters</div>
            <div class="input-tools">
                <div class="tool-group">
                    <button id="typingStickerBtn" onclick="toggleStickerPicker()" title="Stickers (2🪙)">
                        😊
                        <span class="lock-overlay" id="typingStickerLock" style="display:none;">🔒</span>
                    </button>
                    <button id="typingVoiceBtn" onclick="toggleVoiceRecorder()" title="Voice Note (3🪙)">
                        🎤
                        <span class="lock-overlay" id="typingVoiceLock" style="display:none;">🔒</span>
                    </button>
                    <button id="typingImageBtn" onclick="triggerImageUpload()" title="Image (5🪙)">
                        🖼️
                        <span class="lock-overlay" id="typingImageLock" style="display:none;">🔒</span>
                    </button>

                    <button onclick="insertMentionOverlay()" title="Mention" style="font-weight:700;font-size:12px;">@</button>
                </div>
                <div class="send-action">
                    <span class="cost-badge-large">🪙 <span id="typingCostBadge">1</span></span>
                    <button class="btn-send-overlay" id="typingSendBtn" onclick="sendMessageFromOverlay()">Send</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================================
    SEND COINS MODAL
    ============================================================ -->
    <div class="send-coins-overlay" id="sendCoinsOverlay" onclick="closeSendCoinsModal()">
        <div class="send-coins-modal" onclick="event.stopPropagation()">
            <div class="modal-header">
                <span class="modal-title">💸 Send Coins</span>
                <button class="modal-close" onclick="closeSendCoinsModal()">✕</button>
            </div>
            <div class="balance-display">
                <span class="label">Your balance</span>
                <span class="amount">🪙 <span id="sendCoinsBalance">0</span></span>
            </div>
            <div class="recipient-select">
                <label for="sendCoinsRecipient">Recipient</label>
                <select id="sendCoinsRecipient">
                    <option value="">— Select a user —</option>
                </select>
                <div class="helper">Or type their SPIKE ID in the chat: <strong>SP:id/amount</strong></div>
            </div>
            <div class="amount-input">
                <label for="sendCoinsAmount">Amount (🪙)</label>
                <div class="input-wrap">
                    <input type="number" id="sendCoinsAmount" placeholder="Enter amount" min="1" step="1" value="1" />
                </div>
                <div class="quick-amounts">
                    <button onclick="setSendCoinsAmount(5)">5</button>
                    <button onclick="setSendCoinsAmount(10)">10</button>
                    <button onclick="setSendCoinsAmount(25)">25</button>
                    <button onclick="setSendCoinsAmount(50)">50</button>
                    <button onclick="setSendCoinsAmount(100)">100</button>
                    <button onclick="setSendCoinsAmount(250)">250</button>
                </div>
            </div>
            <div class="send-actions">
                <button class="btn-send-coins" id="sendCoinsBtn" onclick="sendCoinsFromModal()">💸 Send Coins</button>
                <button class="btn-cancel" onclick="closeSendCoinsModal()">Cancel</button>
            </div>
            <div class="note">💡 You can also send coins with <strong>SP:id/amount</strong> in the chat (free).</div>
        </div>
    </div>

    <!-- ============================================================
    GIFT SEND MODAL
    ============================================================ -->
    <div class="gift-send-overlay" id="giftSendOverlay" onclick="closeGiftSendModal()">
        <div class="gift-send-modal" onclick="event.stopPropagation()">
            <div class="modal-header">
                <span class="modal-title">🎁 Send Gift</span>
                <button class="modal-close" onclick="closeGiftSendModal()">✕</button>
            </div>
            <div class="recipient-info" id="giftRecipientInfo">
                <div class="avatar" id="giftRecipientAvatar">👤</div>
                <div class="info">
                    <div class="name" id="giftRecipientName">Select a user</div>
                    <div class="spid" id="giftRecipientSpId">SP ID: —</div>
                </div>
            </div>
            <div style="font-size:0.75rem;color:var(--text-muted);margin-bottom:3px;">Choose a gift emoji (cost varies):</div>
            <div class="gift-grid" id="giftSendGrid"></div>
            <div class="send-actions">
                <button class="btn-send-gift" id="giftSendBtn" onclick="sendGiftToUser()">💌 Send Gift</button>
                <button class="btn-cancel" onclick="closeGiftSendModal()">Cancel</button>
            </div>
        </div>
    </div>

    <!-- ============================================================
    GIFTS PANEL
    ============================================================ -->
    <div class="gifts-panel-overlay" id="giftsPanelOverlay" onclick="closeGiftsPanel()">
        <div class="gifts-panel" onclick="event.stopPropagation()">
            <div class="panel-header">
                <span class="panel-title">🎁 My Gifts</span>
                <button class="panel-close" onclick="closeGiftsPanel()">✕</button>
            </div>
            <div id="giftsListContainer"><div class="empty-gifts">Loading…</div></div>
            <div class="panel-actions">
                <button class="convert-all" id="convertAllBtn" onclick="convertAllGifts()">Convert All to Coins</button>
            </div>
        </div>
    </div>

    <!-- Hidden file input for images -->
    <input type="file" id="imageInput" accept="image/*" style="display:none;" onchange="handleImageUpload(event)" />

    <!-- ============================================================
    CONTACT ADMIN MODAL
    ============================================================ -->
    <div class="contact-modal-overlay" id="contactModalOverlay" onclick="closeContactModal()">
        <div class="contact-modal" onclick="event.stopPropagation()">
            <div class="modal-header">
                <span class="modal-title">📞 Contact Admin</span>
                <button class="modal-close" onclick="closeContactModal()">✕</button>
            </div>
            <div class="admin-info">
                <span class="label">Admin</span>
                <div class="value">📧 eletexjoeytex@gmail.com</div>
                <div class="value">📱 +234 915 909 6952</div>
            </div>
            <div id="contactSpIdStatus" class="no-spid-note" style="display:none;">
                ⚠️ You need to set your SPIKE ID in your profile before contacting admin.
            </div>
            <div style="font-size:0.8rem;color:var(--text-muted);margin-bottom:4px;">Select coin package:</div>
            <div class="packages-grid" id="contactPackagesGrid"></div>
            <div style="font-size:0.65rem;color:var(--text-muted);margin-top:4px;">
                Your name and SP ID will be included in the WhatsApp message.
            </div>
            <div class="contact-actions">
                <button class="btn-whatsapp" id="contactWhatsAppBtn" onclick="sendWhatsAppMessage()">💬 WhatsApp Admin</button>
                <button class="btn-cancel" onclick="closeContactModal()">Cancel</button>
            </div>
        </div>
    </div>

    <!-- ============================================================
    PREMIUM PANEL — COMPLETE UPGRADE
    ============================================================ -->
    <div class="premium-panel-overlay" id="premiumPanelOverlay" onclick="closePremiumPanel()">
        <div class="premium-panel" onclick="event.stopPropagation()">
            <div class="panel-head">
                <span class="title">
                    ⭐ Premium Hub
                    <span class="badge-tier" id="premiumTierBadge">Free</span>
                </span>
                <button class="close-btn" onclick="closePremiumPanel()">✕</button>
            </div>
            <div class="panel-body" id="premiumPanelBody">
                <!-- Dynamically rendered -->
            </div>
        </div>
    </div>

    <!-- ============================================================
    STICKER PICKER
    ============================================================ -->
    <div class="sticker-picker-overlay" id="stickerPickerOverlay" onclick="closeStickerPicker()">
        <div class="sticker-picker" onclick="event.stopPropagation()">
            <div class="sticker-header">
                <span class="sticker-title">😊 Stickers <span style="font-size:9px;color:var(--text-muted);">(2🪙 each)</span></span>
                <button class="sticker-close" onclick="closeStickerPicker()">✕</button>
            </div>
            <div class="sticker-categories" id="stickerCategories">
                <button class="active" data-cat="all" onclick="switchStickerCategory('all')">All</button>
                <button data-cat="happy" onclick="switchStickerCategory('happy')">😄</button>
                <button data-cat="sad" onclick="switchStickerCategory('sad')">😢</button>
                <button data-cat="angry" onclick="switchStickerCategory('angry')">😡</button>
                <button data-cat="animals" onclick="switchStickerCategory('animals')">🐾</button>
            </div>
            <div class="sticker-grid" id="stickerGrid"></div>
        </div>
    </div>

    <!-- ============================================================
    REACTION PICKER
    ============================================================ -->
    <div class="reaction-picker-overlay" id="reactionPickerOverlay" onclick="closeReactionPicker()">
        <div class="reaction-picker" onclick="event.stopPropagation()">
            <div class="reaction-grid">
                <button onclick="addReaction('❤️')">❤️</button>
                <button onclick="addReaction('😂')">😂</button>
                <button onclick="addReaction('😮')">😮</button>
                <button onclick="addReaction('😢')">😢</button>
                <button onclick="addReaction('😡')">😡</button>
                <button onclick="addReaction('👍')">👍</button>
                <button onclick="addReaction('👎')">👎</button>
                <button onclick="addReaction('🎉')">🎉</button>
                <button onclick="addReaction('🔥')">🔥</button>
                <button onclick="addReaction('💯')">💯</button>
            </div>
        </div>
    </div>

    <!-- ============================================================
    GIFT RAIN
    ============================================================ -->
    <div class="gift-rain" id="giftRain"></div>

    <!-- ============================================================
    PARTICIPANTS PANEL
    ============================================================ -->
    <div class="participants-overlay" id="participantsOverlay" onclick="toggleParticipants()"></div>
    <div class="participants-panel" id="participantsPanel">
        <div class="panel-header"><span class="title">👥 Members</span><button class="close-btn" onclick="toggleParticipants()">✕</button></div>
        <div id="participantsList"><div class="empty-participants">Loading…</div></div>
    </div>

    <!-- ============================================================
    PROFILE MODAL
    ============================================================ -->
    <div class="profile-modal-overlay" id="profileModalOverlay" onclick="closeProfileModal()">
        <div class="profile-modal" id="profileModal" onclick="event.stopPropagation()">
            <div class="modal-header">
                <span class="modal-title">👤 Profile</span>
                <button class="modal-close" onclick="closeProfileModal()">✕</button>
            </div>
            <div id="profileModalBody"></div>
        </div>
    </div>

    <!-- ============================================================
    USER MENU
    ============================================================ -->
    <div class="user-menu-overlay" id="userMenuOverlay" onclick="closeUserMenu()"></div>
    <div class="user-menu" id="userMenu" style="display:none;">
        <button class="item" id="menuViewProfile"><span class="icon">👤</span> View Profile</button>
        <button class="item" id="menuSendCoins"><span class="icon">💸</span> Send Coins</button>
        <button class="item" id="menuPrivateMsg"><span class="icon">💬</span> Private Message</button>
        <button class="item" id="menuSendGift"><span class="icon">🎁</span> Send Gift</button>
        <button class="item" id="menuReport"><span class="icon">🚩</span> Report User</button>
        <button class="item danger" id="menuKick" style="display:none;"><span class="icon">👢</span> Kick User</button>
        <button class="item danger" id="menuMute" style="display:none;"><span class="icon">🔇</span> Mute User</button>
        <button class="item" id="menuWaiveFee" style="display:none;"><span class="icon">💰</span> Waive Fee</button>
    </div>

    <!-- ============================================================
    TOAST — FIXED
    ============================================================ -->
    <div class="toast-container" id="toast">
        <div class="toast-content">
            <div class="toast-icon-wrapper" id="toastIconWrapper">
                <span id="toastIcon">✓</span>
            </div>
            <div class="toast-body">
                <div class="toast-title" id="toastTitle">Success</div>
                <div class="toast-message" id="toastMsg">Action completed</div>
            </div>
            <button class="toast-close" onclick="dismissToast()">✕</button>
            <div class="toast-progress" id="toastProgress"></div>
        </div>
    </div>

    <!-- ============================================================
    CONFIRM MODAL
    ============================================================ -->
    <div class="confirm-overlay" id="confirmOverlay">
        <div class="confirm-modal">
            <div class="icon" id="confirmIcon">⚠️</div>
            <div class="title" id="confirmTitle">Are you sure?</div>
            <div class="message" id="confirmMsg">This action cannot be undone.</div>
            <div class="actions">
                <button class="cancel" id="confirmCancel" onclick="confirmCancel()">Cancel</button>
                <button class="danger" id="confirmConfirm" onclick="confirmOk()">Confirm</button>
            </div>
        </div>
    </div>

    <!-- ============================================================
    SCRIPTS
    ============================================================ -->
    <script type="module">
        // ============================================================
        // ROOM.JS — SPIKE ELITE ROOM
        // ============================================================

        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
        import { getAuth, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";
        import {
            getFirestore, collection, doc, getDoc, setDoc, updateDoc, deleteDoc, addDoc,
            getDocs, query, orderBy, limit, onSnapshot, runTransaction, serverTimestamp,
            arrayUnion, arrayRemove, increment, where
        } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

        // NOTE: Firebase config is exposed in client-side code.
        // For production, consider using environment variables or a backend service to hide API keys.
        const CONFIG = {
            apiKey: "AIzaSyAm8ghbQ_lwJdNXEhWGos0eyi5wtvGuRR4",
            authDomain: "grazzy-9e736.firebaseapp.com",
            projectId: "grazzy-9e736",
            storageBucket: "grazzy-9e736.firebasestorage.app",
            messagingSenderId: "750326949170",
            appId: "1:750326949170:web:5d19744aafc8675918632b"
        };
        const app = initializeApp(CONFIG);
        const auth = getAuth(app);
        const db = getFirestore(app);

        // ============================================================
        // COST CONFIG
        // ============================================================
        const COSTS = { text: 1, sticker: 2, voice: 3, image: 5 };

        const GIFT_EMOJIS = [
            { emoji: '❤️', cost: 2 },
            { emoji: '😊', cost: 2 },
            { emoji: '🔥', cost: 5 },
            { emoji: '🎉', cost: 5 },
            { emoji: '💎', cost: 10 },
            { emoji: '🌟', cost: 20 },
        ];

        const coinPackages = [
            { amount: 10, price: 0.09 },
            { amount: 25, price: 0.19 },
            { amount: 50, price: 0.39 },
            { amount: 100, price: 0.79 },
            { amount: 250, price: 1.99 },
            { amount: 500, price: 3.99 },
            { amount: 1000, price: 7.99 },
            { amount: 2000, price: 14.99 },
            { amount: 5000, price: 24.99 },
            { amount: 10000, price: 39.99 },
        ];

        // FEATURES
        const features = [
            { id: 'vip_crown', label: 'VIP Crown', icon: '👑', tier: 'VIP', tierClass: 'vip',
            available: (u) => u.isVIP },
            { id: 'stickers', label: 'Stickers', icon: '😊', tier: 'VIP', tierClass: 'vip', available: (u) => u
                    .isVIP, cost: COSTS.sticker },
            { id: 'voice_notes', label: 'Voice Notes', icon: '🎤', tier: 'Premium', tierClass: 'premium',
                available: (u) => u.isPremium || u.isElite, cost: COSTS.voice },
            { id: 'image_sharing', label: 'Image Sharing', icon: '🖼️', tier: 'Elite', tierClass: 'elite',
                available: (u) => u.isElite, cost: COSTS.image },
            { id: 'custom_colour', label: 'Custom Colour', icon: '🎨', tier: 'Elite', tierClass: 'elite',
                available: (u) => u.isElite },
            { id: 'pin_messages', label: 'Pin Messages', icon: '📌', tier: 'Elite', tierClass: 'elite',
                available: (u) => u.isElite },
            { id: 'daily_bonus', label: '2x Daily Bonus', icon: '💰', tier: 'VIP', tierClass: 'vip',
                available: (u) => u.isVIP },
        ];

