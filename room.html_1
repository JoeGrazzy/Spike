        // ============================================================
        // TOAST — FIXED & RELIABLE
        // ============================================================
        function showToast(msg, type = 'success', title = '') {
            const t = document.getElementById('toast');
            const icon = document.getElementById('toastIcon');
            const iconWrapper = document.getElementById('toastIconWrapper');
            const titleEl = document.getElementById('toastTitle');
            const msgEl = document.getElementById('toastMsg');
            const progress = document.getElementById('toastProgress');

            if (toastTimeout) { clearTimeout(toastTimeout);
                toastTimeout = null; }

            t.className = 'toast-container';
            iconWrapper.className = 'toast-icon-wrapper';

            const types = {
                success: { icon: '✓', class: 'success', progress: 'success', title: 'Success' },
                error: { icon: '✕', class: 'error', progress: 'error', title: 'Error' },
                warning: { icon: '⚠️', class: 'warning', progress: 'warning', title: 'Warning' },
                info: { icon: 'ℹ️', class: 'info', progress: 'info', title: 'Info' },
                premium: { icon: '⭐', class: 'premium', progress: 'premium', title: 'Premium' },
                elite: { icon: '🔥', class: 'elite', progress: 'elite', title: 'ELITE' },
                gold: { icon: '🏆', class: 'gold', progress: 'gold', title: 'Gold' }
            };
            const selected = types[type] || types.success;
            icon.textContent = selected.icon;
            iconWrapper.classList.add(selected.class);
            titleEl.textContent = title || selected.title;
            msgEl.textContent = msg;
            progress.className = 'toast-progress ' + selected.progress;

            void t.offsetWidth;
            t.classList.add('active');

            toastTimeout = setTimeout(() => {
                t.classList.add('removing');
                setTimeout(() => {
                    t.className = 'toast-container';
                    t.classList.remove('removing');
                    toastTimeout = null;
                }, 400);
            }, 3500);

            addNotification(msg, type, title || selected.title);
        }

        window.dismissToast = function() {
            const t = document.getElementById('toast');
            if (!t.classList.contains('active')) return;
            t.classList.add('removing');
            setTimeout(() => {
                t.className = 'toast-container';
                t.classList.remove('removing');
                if (toastTimeout) { clearTimeout(toastTimeout);
                    toastTimeout = null; }
            }, 400);
        };

        // ============================================================
        // NOTIFICATION FEED
        // ============================================================
        function addNotification(message, type = 'info', title = '') {
            const entry = {
                id: Date.now() + '_' + Math.random().toString(36).substr(2, 4),
                message,
                type,
                title: title || type.charAt(0).toUpperCase() + type.slice(1),
                timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
                time: Date.now()
            };
            notificationFeed.unshift(entry);
            if (notificationFeed.length > MAX_NOTIFICATIONS) {
                notificationFeed = notificationFeed.slice(0, MAX_NOTIFICATIONS);
            }
            if (premiumPanelOverlay.classList.contains('open')) {
                renderPremiumPanel();
            }
        }

        function clearNotifications() {
            notificationFeed = [];
            if (premiumPanelOverlay.classList.contains('open')) {
                renderPremiumPanel();
            }
        }

        // ============================================================
        // CONFIRM
        // ============================================================
        function showConfirm(opts) {
            return new Promise(r => {
                const o = document.getElementById('confirmOverlay');
                document.getElementById('confirmIcon').textContent = opts.icon || '⚠️';
                document.getElementById('confirmTitle').textContent = opts.title || 'Are you sure?';
                document.getElementById('confirmMsg').textContent = opts.message || 'This cannot be undone.';
                document.getElementById('confirmConfirm').textContent = opts.confirmText || 'Confirm';
                document.getElementById('confirmConfirm').className = opts.confirmType || 'danger';
                pendingConfirm = { resolve: r };
                o.classList.add('active');
            });
        }
        window.confirmOk = function() {
            if (pendingConfirm) { pendingConfirm.resolve(true);
                pendingConfirm = null; }
            document.getElementById('confirmOverlay').classList.remove('active');
        };
        window.confirmCancel = function() {
            if (pendingConfirm) { pendingConfirm.resolve(false);
                pendingConfirm = null; }
            document.getElementById('confirmOverlay').classList.remove('active');
        };
        document.getElementById('confirmOverlay').addEventListener('click', e => {
            if (e.target === e.currentTarget) confirmCancel();
        });

        // ============================================================
        // COINS HELPERS
        // ============================================================
        async function getCoins(uid) {
            try {
                const s = await getDoc(doc(db, 'users', uid));
                return s.exists() ? (s.data().coins || 0) : 0;
            } catch { return 0; }
        }

        async function updateCoins(uid, amount, reason) {
            await runTransaction(db, async (tx) => {
                const ref = doc(db, 'users', uid);
                const s = await tx.get(ref);
                const cur = s.exists() ? (s.data().coins || 0) : 0;
                if (cur + amount < 0) throw new Error('Not enough coins');
                tx.update(ref, { coins: cur + amount });
                await tx.set(doc(collection(db, 'transactions')), {
                    userId: uid,
                    amount,
                    newBalance: cur + amount,
                    reason,
                    timestamp: serverTimestamp()
                });
            });
            return true;
        }

        async function deductCoinsIfPossible(amount, reason) {
            if (amount <= 0) return true;
            if (coinBalance < amount) {
                showToast(`Insufficient coins! Need ${amount} 🪙`, 'error');
                return false;
            }
            try {
                await updateCoins(currentUser.uid, -amount, reason);
                coinBalance = await getCoins(currentUser.uid);
                coinEl.textContent = coinBalance;
                document.getElementById('sendCoinsBalance').textContent = coinBalance;
                return true;
            } catch (e) {
                showToast('Transaction failed: ' + e.message, 'error');
                return false;
            }
        }

        // ============================================================
        // FIND USER BY SP ID
        // ============================================================
        async function findUserByIdentifier(identifier) {
            const q1 = query(collection(db, 'users'), where('spId', '==', identifier));
            const snap1 = await getDocs(q1);
            if (!snap1.empty) {
                const docSnap = snap1.docs[0];
                return { uid: docSnap.id, data: docSnap.data() };
            }
            const docRef = doc(db, 'users', identifier);
            const snap2 = await getDoc(docRef);
            if (snap2.exists()) {
                return { uid: identifier, data: snap2.data() };
            }
            return null;
        }

        // ============================================================
        // SEND COINS VIA SP COMMAND
        // ============================================================
        async function sendCoinsViaSP(spId, amount) {
            if (!currentUser || !hasPaid) {
                showToast('You must be in the room to send coins.', 'warning');
                return false;
            }
            if (amount < 1) {
                showToast('Amount must be at least 1 🪙.', 'warning');
                return false;
            }
            if (amount > coinBalance) {
                showToast(`You only have ${coinBalance} 🪙.`, 'error');
                return false;
            }

            const recipient = await findUserByIdentifier(spId);
            if (!recipient) {
                showToast(`User with SP ID "${spId}" not found.`, 'error');
                return false;
            }
            if (recipient.uid === currentUser.uid) {
                showToast('You cannot send coins to yourself.', 'warning');
                return false;
            }

            try {
                await runTransaction(db, async (tx) => {
                    const senderRef = doc(db, 'users', currentUser.uid);
                    const receiverRef = doc(db, 'users', recipient.uid);
                    const senderSnap = await tx.get(senderRef);
                    const receiverSnap = await tx.get(receiverRef);
                    const senderBal = senderSnap.exists() ? (senderSnap.data().coins || 0) : 0;
                    const receiverBal = receiverSnap.exists() ? (receiverSnap.data().coins || 0) : 0;
                    if (senderBal < amount) throw new Error('Insufficient coins');
                    tx.update(senderRef, { coins: senderBal - amount });
                    tx.update(receiverRef, { coins: receiverBal + amount });
                    await tx.set(doc(collection(db, 'transactions')), {
                        userId: currentUser.uid,
                        type: 'send',
                        toUid: recipient.uid,
                        amount: -amount,
                        newBalance: senderBal - amount,
                        reason: `Sent ${amount} coins to ${recipient.data.name || recipient.uid} (SP:${spId})`,
                        status: 'completed',
                        timestamp: serverTimestamp()
                    });
                    await tx.set(doc(collection(db, 'transactions')), {
                        userId: recipient.uid,
                        type: 'receive',
                        fromUid: currentUser.uid,
                        amount: amount,
                        newBalance: receiverBal + amount,
                        reason: `Received ${amount} coins from ${currentUser.displayName || 'User'} (SP:${spId})`,
                        status: 'completed',
                        timestamp: serverTimestamp()
                    });
                });

                coinBalance = await getCoins(currentUser.uid);
                coinEl.textContent = coinBalance;
                document.getElementById('sendCoinsBalance').textContent = coinBalance;

                const senderName = currentUser.displayName || 'User';
                const receiverName = recipient.data.name || recipient.uid;
                await addDoc(collection(db, 'rooms', roomId, 'messages'), {
                    senderId: 'system',
                    senderName: 'SPIKE',
                    text: `🪙 ${senderName} sent ${amount} coins to ${receiverName} (SP:${spId})`,
                    type: 'system',
                    timestamp: serverTimestamp()
                });
                showToast(`✅ ${amount} coins sent to ${receiverName}!`, 'success');
                addNotification(`Sent ${amount}🪙 to ${receiverName}`, 'success', 'Coins Sent');
                return true;
            } catch (err) {
                showToast(err.message || 'Failed to send coins.', 'error');
                return false;
            }
        }

        // ============================================================
        // SEND COINS MODAL
        // ============================================================
        window.openSendCoinsModal = function() {
            if (!currentUser || !hasPaid) {
                showToast('You must be in the room to send coins.', 'warning');
                return;
            }
            document.getElementById('sendCoinsBalance').textContent = coinBalance;
            populateRecipientSelect();
            document.getElementById('sendCoinsOverlay').classList.add('open');
        };

        window.closeSendCoinsModal = function() {
            document.getElementById('sendCoinsOverlay').classList.remove('open');
        };

        async function populateRecipientSelect() {
            const sel = document.getElementById('sendCoinsRecipient');
            sel.innerHTML = '<option value="">— Select a user —</option>';
            try {
                const snap = await getDocs(collection(db, 'rooms', roomId, 'participants'));
                const uids = [];
                snap.forEach(d => uids.push(d.id));
                for (const uid of uids) {
                    if (uid === currentUser.uid) continue;
                    try {
                        const s = await getDoc(doc(db, 'users', uid));
                        if (s.exists()) {
                            const data = s.data();
                            const name = data.name || data.displayName || 'User';
                            const spId = data.spId || 'N/A';
                            const opt = document.createElement('option');
                            opt.value = uid;
                            opt.textContent = `${name} (SP:${spId})`;
                            opt.dataset.spid = spId;
                            sel.appendChild(opt);
                        }
                    } catch (e) {}
                }
            } catch (e) {
                console.error('Failed to load participants for coin send:', e);
            }
        }

        window.setSendCoinsAmount = function(amount) {
            document.getElementById('sendCoinsAmount').value = amount;
        };

        window.sendCoinsFromModal = async function() {
            const sel = document.getElementById('sendCoinsRecipient');
            const uid = sel.value;
            const amount = parseInt(document.getElementById('sendCoinsAmount').value);
            if (!uid) {
                showToast('Please select a recipient.', 'warning');
                return;
            }
            if (!amount || amount < 1) {
                showToast('Please enter a valid amount (min 1 🪙).', 'warning');
                return;
            }
            if (amount > coinBalance) {
                showToast(`You only have ${coinBalance} 🪙.`, 'error');
                return;
            }
            const selectedOpt = sel.options[sel.selectedIndex];
            const spId = selectedOpt?.dataset?.spid;
            if (!spId) {
                showToast('Recipient has no SPIKE ID.', 'error');
                return;
            }
            const success = await sendCoinsViaSP(spId, amount);
            if (success) {
                closeSendCoinsModal();
            }
        };

        // ============================================================
        // GIFT FUNCTIONS
        // ============================================================
        window.openGiftSendModal = function(recipientUid = null) {
            if (!currentUser || !hasPaid) {
                showToast('You must be in the room to send gifts.', 'warning');
                return;
            }
            selectedGiftEmoji = null;
            giftRecipientUid = recipientUid;

            const grid = document.getElementById('giftSendGrid');
            grid.innerHTML = GIFT_EMOJIS.map((g, idx) => `
                    <button class="${selectedGiftEmoji === g.emoji ? 'selected' : ''}" data-emoji="${g.emoji}" data-cost="${g.cost}" onclick="selectGiftEmoji('${g.emoji}', ${g.cost})">
                        ${g.emoji}
                        <span class="gift-cost-popup">${g.cost}</span>
                    </button>
                `).join('');

            if (recipientUid) {
                loadRecipientInfo(recipientUid);
            } else {
                const infoDiv = document.getElementById('giftRecipientInfo');
                infoDiv.innerHTML = `
                        <div class="avatar" id="giftRecipientAvatar">👤</div>
                        <div class="info">
                            <div class="name" id="giftRecipientName">Select a user</div>
                            <div class="spid" id="giftRecipientSpId">SP ID: —</div>
                            <div class="input-wrap" style="margin-top:4px;">
                                <input type="text" id="giftRecipientInput" placeholder="Enter SP ID or name" />
                                <button onclick="findGiftRecipient()">Find</button>
                            </div>
                        </div>
                    `;
                giftRecipientUid = null;
            }
            document.getElementById('giftSendOverlay').classList.add('open');
        };

        window.closeGiftSendModal = function() {
            document.getElementById('giftSendOverlay').classList.remove('open');
            giftRecipientUid = null;
            selectedGiftEmoji = null;
        };

        async function loadRecipientInfo(uid) {
            try {
                const docSnap = await getDoc(doc(db, 'users', uid));
                if (!docSnap.exists()) {
                    showToast('User not found', 'error');
                    return;
                }
                const data = docSnap.data();
                const name = data.name || data.displayName || 'User';
                const spId = data.spId || 'N/A';
                const avatar = data.avatar || '';
                const infoDiv = document.getElementById('giftRecipientInfo');
                infoDiv.innerHTML = `
                        <div class="avatar" id="giftRecipientAvatar">${avatar ? `<img src="${avatar}">` : escapeHTML(name.charAt(0).toUpperCase())}</div>
                        <div class="info">
                            <div class="name" id="giftRecipientName">${escapeHTML(name)}</div>
                            <div class="spid" id="giftRecipientSpId">SP ID: ${escapeHTML(spId)}</div>
                        </div>
                    `;
                giftRecipientUid = uid;
            } catch (e) {
                showToast('Error loading recipient', 'error');
            }
        }

        window.findGiftRecipient = async function() {
            const input = document.getElementById('giftRecipientInput');
            if (!input) return;
            const queryStr = input.value.trim();
            if (!queryStr) {
                showToast('Enter a name or SPIKE ID', 'warning');
                return;
            }
            const qSpId = query(collection(db, 'users'), where('spId', '==', queryStr));
            const snapSpId = await getDocs(qSpId);
            if (!snapSpId.empty) {
                const docSnap = snapSpId.docs[0];
                await loadRecipientInfo(docSnap.id);
                return;
            }
            const qName = query(collection(db, 'users'), where('name', '>=', queryStr), where('name', '<=', queryStr +
                '\uf8ff'));
            const snapName = await getDocs(qName);
            if (!snapName.empty) {
                const docSnap = snapName.docs[0];
                await loadRecipientInfo(docSnap.id);
                return;
            }
            showToast('No user found', 'error');
        };

        window.selectGiftEmoji = function(emoji, cost) {
            selectedGiftEmoji = emoji;
            document.querySelectorAll('#giftSendGrid button').forEach(btn => {
                btn.classList.toggle('selected', btn.dataset.emoji === emoji);
            });
            document.getElementById('giftSendBtn').textContent = `💌 Send ${emoji} (${cost}🪙)`;
        };

        window.sendGiftToUser = async function() {
            if (!currentUser || !hasPaid) {
                showToast('You must be in the room to send gifts.', 'warning');
                return;
            }
            if (!giftRecipientUid) {
                showToast('Please select a recipient first.', 'warning');
                return;
            }
            if (!selectedGiftEmoji) {
                showToast('Please select a gift emoji.', 'warning');
                return;
            }
            const giftData = GIFT_EMOJIS.find(g => g.emoji === selectedGiftEmoji);
            if (!giftData) return;
            const cost = giftData.cost;

            if (!await deductCoinsIfPossible(cost, `Send gift ${selectedGiftEmoji}`)) return;

            try {
                const giftRef = doc(collection(db, 'users', giftRecipientUid, 'gifts'));
                await setDoc(giftRef, {
                    fromUid: currentUser.uid,
                    fromName: currentUser.displayName || 'User',
                    emoji: selectedGiftEmoji,
                    value: cost,
                    timestamp: serverTimestamp(),
                    converted: false
                });

                const recipientName = document.getElementById('giftRecipientName')?.textContent || 'user';
                await addDoc(collection(db, 'rooms', roomId, 'messages'), {
                    senderId: 'system',
                    senderName: 'SPIKE',
                    text: `🎁 ${currentUser.displayName || 'User'} sent a gift ${selectedGiftEmoji} to ${recipientName}!`,
                    type: 'system',
                    timestamp: serverTimestamp()
                });

                if (cost >= 10) triggerGiftRain(selectedGiftEmoji, cost === 20 ? 40 : 20);
                showToast(`Gift ${selectedGiftEmoji} sent! -${cost}🪙`, 'success');
                addNotification(`Sent ${selectedGiftEmoji} gift to ${recipientName}`, 'gold', 'Gift Sent');
                closeGiftSendModal();
                loadGiftBadgeCount();
            } catch (err) {
                showToast('Failed to send gift: ' + err.message, 'error');
            }
        };

        // ============================================================
        // GIFT RAIN
        // ============================================================
        function triggerGiftRain(emoji, count = 20) {
            const container = document.getElementById('giftRain');
            for (let i = 0; i < count; i++) {
                const el = document.createElement('div');
                el.className = 'drop';
                el.textContent = emoji;
                el.style.left = Math.random() * 100 + '%';
                el.style.fontSize = (22 + Math.random() * 30) + 'px';
                el.style.animationDuration = (2 + Math.random() * 3) + 's';
                el.style.animationDelay = (Math.random() * 1.5) + 's';
                container.appendChild(el);
                setTimeout(() => el.remove(), 6000);
            }
        }

        // ============================================================
        // GIFTS PANEL
        // ============================================================
        window.openGiftsPanel = function() {
            if (!currentUser) { showToast('Please sign in.', 'warning'); return; }
            document.getElementById('giftsPanelOverlay').classList.add('open');
            loadGifts();
        };

        window.closeGiftsPanel = function() {
            document.getElementById('giftsPanelOverlay').classList.remove('open');
        };

        async function loadGifts() {
            const containerEl = document.getElementById('giftsListContainer');
            containerEl.innerHTML = '<div class="empty-gifts">Loading your gifts…</div>';
            try {
                const q = query(collection(db, 'users', currentUser.uid, 'gifts'), orderBy('timestamp', 'desc'));
                const snap = await getDocs(q);
                if (snap.empty) {
                    containerEl.innerHTML = '<div class="empty-gifts">You have no gifts yet. 🌟</div>';
                    document.getElementById('convertAllBtn').disabled = true;
                    return;
                }
                let html = '';
                let unconvertedCount = 0;
                snap.forEach(docSnap => {
                    const data = docSnap.data();
                    const id = docSnap.id;
                    const converted = data.converted === true;
                    if (!converted) unconvertedCount++;
                    const fromName = data.fromName || 'Unknown';
                    const emoji = data.emoji || '🎁';
                    const value = data.value || 0;
                    const time = data.timestamp?.toDate ? data.timestamp.toDate() : new Date();
                    const dateStr = time.toLocaleDateString() + ' ' + time.toLocaleTimeString([], { hour: '2-digit',
                        minute: '2-digit' });
                    html += `
                            <div class="gift-item" data-id="${id}">
                                <div class="gift-emoji">${emoji}</div>
                                <div class="gift-info">
                                    <div class="gift-from">from ${escapeHTML(fromName)}</div>
                                    <div class="gift-meta">
                                        <span class="gift-value">🪙 ${value}</span>
                                        <span>${dateStr}</span>
                                    </div>
                                </div>
                                <div class="gift-actions">
                                    ${converted ? `<button class="converted" disabled>✓ Converted</button>` : `<button class="convert" onclick="convertGift('${id}')">Convert</button>`}
                                </div>
                            </div>
                        `;
                });
                containerEl.innerHTML = html;
                const btn = document.getElementById('convertAllBtn');
                btn.disabled = unconvertedCount === 0;
                btn.textContent = `Convert All (${unconvertedCount})`;
                giftBadgeCount = unconvertedCount;
                updateGiftBadge();
            } catch (e) {
                containerEl.innerHTML = '<div class="empty-gifts" style="color:var(--error);">Failed to load gifts.</div>';
                console.error(e);
            }
        }

        function updateGiftBadge() {
            const show = giftBadgeCount > 0;
            const text = giftBadgeCount > 9 ? '9+' : giftBadgeCount;
            giftBadge.textContent = text;
            giftBadge.style.display = show ? 'flex' : 'none';
            moreGiftBadge.textContent = text;
            moreGiftBadge.style.display = show ? 'inline-block' : 'none';
        }

        window.convertGift = async function(giftId) {
            if (!currentUser) return;
            const ok = await showConfirm({
                icon: '🪙',
                title: 'Convert Gift',
                message: 'This will add the gift\'s coin value to your balance and remove the gift. Continue?',
                confirmText: 'Convert',
                confirmType: 'primary'
            });
            if (!ok) return;

            try {
                const giftRef = doc(db, 'users', currentUser.uid, 'gifts', giftId);
                const snap = await getDoc(giftRef);
                if (!snap.exists()) { showToast('Gift not found.', 'error'); return; }
                const data = snap.data();
                if (data.converted) { showToast('Gift already converted.', 'warning'); return; }
                const value = data.value || 0;
                await updateCoins(currentUser.uid, value, `Converted gift ${data.emoji}`);
                await updateDoc(giftRef, { converted: true });
                coinBalance = await getCoins(currentUser.uid);
                coinEl.textContent = coinBalance;
                document.getElementById('sendCoinsBalance').textContent = coinBalance;
                showToast(`Converted! +${value}🪙`, 'success');
                addNotification(`Converted ${data.emoji} gift → +${value}🪙`, 'gold', 'Gift Converted');
                loadGifts();
            } catch (e) {
                showToast('Conversion failed: ' + e.message, 'error');
            }
        };

        window.convertAllGifts = async function() {
            if (!currentUser) return;
            const ok = await showConfirm({
                icon: '🪙',
                title: 'Convert All Gifts',
                message: 'This will convert all your unconverted gifts into coins. Continue?',
                confirmText: 'Convert All',
                confirmType: 'primary'
            });
            if (!ok) return;

            try {
                const q = query(collection(db, 'users', currentUser.uid, 'gifts'), where('converted', '==', false));
                const snap = await getDocs(q);
                if (snap.empty) { showToast('No gifts to convert.', 'info'); return; }
                let totalValue = 0;
                const batch = [];
                snap.forEach(docSnap => {
                    const data = docSnap.data();
                    totalValue += data.value || 0;
                    batch.push({ id: docSnap.id, ref: docSnap.ref });
                });
                await updateCoins(currentUser.uid, totalValue, `Converted all gifts (${snap.size} gifts)`);
                const promises = batch.map(item => updateDoc(item.ref, { converted: true }));
                await Promise.all(promises);
                coinBalance = await getCoins(currentUser.uid);
                coinEl.textContent = coinBalance;
                document.getElementById('sendCoinsBalance').textContent = coinBalance;
                showToast(`Converted ${snap.size} gifts! +${totalValue}🪙`, 'success');
                addNotification(`Converted ${snap.size} gifts → +${totalValue}🪙`, 'gold', 'Bulk Convert');
                loadGifts();
            } catch (e) {
                showToast('Conversion failed: ' + e.message, 'error');
            }
        };

        async function loadGiftBadgeCount() {
            if (!currentUser) return;
            try {
                const q = query(collection(db, 'users', currentUser.uid, 'gifts'), where('converted', '==', false));
                const snap = await getDocs(q);
                giftBadgeCount = snap.size;
                updateGiftBadge();
            } catch (e) {
                console.error('Failed to load gift badge count:', e);
            }
        }

        // ============================================================
        // CONTACT ADMIN
        // ============================================================
        window.openContactModal = function() {
            if (!userSpId) {
                document.getElementById('contactSpIdStatus').style.display = 'block';
            } else {
                document.getElementById('contactSpIdStatus').style.display = 'none';
            }
            const grid = document.getElementById('contactPackagesGrid');
            grid.innerHTML = coinPackages.map((pkg, idx) => `
                    <button class="pkg-btn" data-index="${idx}" onclick="selectCoinPackage(${idx})">
                        <span class="pkg-amount">${pkg.amount}</span>
                        <span class="pkg-price">$${pkg.price}</span>
                    </button>
                `).join('');
            document.querySelectorAll('.pkg-btn').forEach(b => b.classList.remove('selected'));
            selectedPackage = null;
            document.getElementById('contactModalOverlay').classList.add('open');
        };

        window.closeContactModal = function() {
            document.getElementById('contactModalOverlay').classList.remove('open');
            selectedPackage = null;
        };

        window.selectCoinPackage = function(index) {
            document.querySelectorAll('.pkg-btn').forEach(b => b.classList.remove('selected'));
            document.querySelector(`.pkg-btn[data-index="${index}"]`).classList.add('selected');
            selectedPackage = coinPackages[index];
        };

        window.sendWhatsAppMessage = function() {
            if (!selectedPackage) { showToast('Please select a coin package first', 'warning'); return; }
            if (!userSpId) { showToast('Please set your SPIKE ID in your profile first', 'error'); return; }
            const name = currentUser.displayName || 'User';
            const spId = userSpId;
            const amount = selectedPackage.amount;
            const price = selectedPackage.price;
            const phone = '2349159096952';
            const message = `Hi, I am ${name}, SP ID: ${spId}. I would like to buy ${amount} coins for $${price}.`;
            const url = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
            window.open(url, '_blank');
            closeContactModal();
            addNotification(`Contacted admin for ${amount}🪙 package`, 'info', 'Admin Contact');
        };

        // ============================================================
        // PREMIUM PANEL — COMPLETE UPGRADE
        // ============================================================
        window.openPremiumPanel = function() {
            renderPremiumPanel();
            premiumPanelOverlay.classList.add('open');
        };

        window.closePremiumPanel = function() {
            premiumPanelOverlay.classList.remove('open');
        };

        function renderPremiumPanel() {
            const body = premiumPanelBody;

            let tier = 'Free';
            let tierClass = 'free';
            let tierIcon = '🆓';
            let tierDesc = 'Join VIP, Premium or ELITE to unlock features.';
            if (isElite) { tier = 'ELITE';
                tierClass = 'elite';
                tierIcon = '🔥';
                tierDesc = 'You have full access to all features!'; } else if (isPremium) { tier = 'Premium';
                tierClass = 'premium';
                tierIcon = '⭐';
                tierDesc = 'You have access to Premium features.'; } else if (isVIP) { tier = 'VIP';
                tierClass = 'vip';
                tierIcon = '👑';
                tierDesc = 'You have access to VIP features.'; }

            premiumTierBadge.textContent = tier;
            premiumTierBadge.className = 'badge-tier ' + tierClass;

            let featureHTML = '';
            features.forEach(f => {
                const avail = f.available({ isVIP, isPremium, isElite });
                const lockedClass = avail ? 'available' : 'locked';
                const statusClass = avail ? 'unlocked' : 'locked';
                const statusText = avail ? '✅' : '🔒';
                const tierTagClass = f.tierClass;
                const costText = f.cost ? `🪙${f.cost}` : '';
                featureHTML += `
                        <div class="feature-item ${lockedClass}">
                            <span class="f-icon">${f.icon}</span>
                            <div class="f-info">
                                <div class="f-name">${f.label}</div>
                                <div class="f-tier">
                                    <span class="tier-tag-sm ${tierTagClass}">${f.tier}</span>
                                    ${costText ? ` <span style="opacity:0.5;">·</span> ${costText}` : ''}
                                </div>
                            </div>
                            <span class="f-status ${statusClass}">${statusText}</span>
                        </div>
                    `;
            });

            let upgradeHTML = '';
            if (!isVIP) {
                upgradeHTML +=
                    `<button class="vip-upgrade" onclick="buyVIP()">👑 VIP 200</button>`;
            }
            if (!isPremium) {
                upgradeHTML +=
                    `<button class="premium-upgrade" onclick="upgradeToPremium()" ${isVIP ? '' : 'disabled'}>⭐ Premium 500 ${!isVIP ? ' (need VIP first)' : ''}</button>`;
            }
            if (!isElite) {
                upgradeHTML +=
                    `<button class="elite-upgrade" onclick="upgradeToElite()" ${isPremium ? '' : 'disabled'}>🔥 Elite 1000 ${!isPremium ? ' (need Premium first)' : ''}</button>`;
            }
            if (isVIP && isPremium && isElite) {
                upgradeHTML =
                    `<button style="flex:1;background:var(--success);color:#fff;box-shadow:none;opacity:0.7;" disabled>🏆 Max Tier</button>`;
            }

            let notifHTML = '';
            if (notificationFeed.length === 0) {
                notifHTML = `<div class="notif-empty">No notifications yet</div>`;
            } else {
                notifHTML = notificationFeed.slice(0, 20).map(n => `
                        <div class="notif-item ${n.type}">
                            <span class="n-icon">${n.type === 'success' ? '✅' : n.type === 'error' ? '❌' : n.type === 'warning' ? '⚠️' : n.type === 'premium' ? '⭐' : n.type === 'elite' ? '🔥' : n.type === 'gold' ? '🏆' : 'ℹ️'}</span>
                            <span class="n-text">${escapeHTML(n.message)}</span>
                            <span class="n-time">${n.timestamp}</span>
                        </div>
                    `).join('');
            }

            body.innerHTML = `
                    <div class="tier-status">
                        <div class="tier-icon">${tierIcon}</div>
                        <div class="tier-info">
                            <div class="tier-label">Current Tier</div>
                            <div class="tier-name"><span class="highlight-${tierClass}">${tier}</span></div>
                            <div class="tier-desc">${tierDesc}</div>
                        </div>
                        <div class="tier-badge ${tierClass}">${tier}</div>
                    </div>

                    <div class="features-title">✨ Features</div>
                    <div class="feature-grid">${featureHTML}</div>

                    ${(!isVIP || !isPremium || !isElite) ? `
                        <div class="upgrade-section">
                            <div class="upgrade-title">⬆️ Upgrade</div>
                            <div class="upgrade-buttons">${upgradeHTML}</div>
                        </div>
                    ` : ''}

                    <div class="notif-title">
                        📬 Notifications
                        <button class="clear-btn" onclick="clearNotifications()">Clear all</button>
                    </div>
                    <div class="notif-feed">${notifHTML}</div>
                `;
        }

        // ============================================================
        // UPGRADES
        // ============================================================
        window.upgradeToPremium = async function() {
            if (!hasPaid || !currentUser) { showToast('Join the room first', 'warning'); return; }
            if (isPremium) { showToast('Already Premium!', 'warning'); return; }
            if (!isVIP) { showToast('You need VIP first (200🪙) to unlock Premium.', 'warning'); return; }
            const cost = 500;
            try {
                await updateCoins(currentUser.uid, -cost, 'Premium upgrade');
                const partRef = doc(db, 'rooms', roomId, 'participants', currentUser.uid);
                await updateDoc(partRef, { premium: true });
                isPremium = true;
                premiumTag.classList.add('show');
                coinBalance = await getCoins(currentUser.uid);
                coinEl.textContent = coinBalance;
                document.getElementById('sendCoinsBalance').textContent = coinBalance;
                if (roomData.createdBy) {
                    await updateCoins(roomData.createdBy, Math.floor(cost * 0.3), 'Premium cut');
                }
                achievements.push('Premium Member');
                showToast('⭐ You are now Premium!', 'premium', 'Premium');
                addNotification('Upgraded to Premium ⭐', 'premium', 'Upgrade');
                await addDoc(collection(db, 'rooms', roomId, 'messages'), {
                    senderId: 'system',
                    senderName: 'SPIKE',
                    text: `${currentUser.displayName || 'User'} became Premium ⭐`,
                    type: 'system',
                    timestamp: serverTimestamp()
                });
                updateTierLocks();
                closePremiumPanel();
                renderPremiumPanel();
            } catch (err) {
                showToast(err.message || 'Not enough coins (need 500 🪙)', 'error');
            }
        };

        window.upgradeToElite = async function() {
            if (!hasPaid || !currentUser) { showToast('Join the room first', 'warning'); return; }
            if (isElite) { showToast('You are already ELITE!', 'gold', 'ELITE'); return; }
            if (!isPremium) { showToast('You need Premium first (500🪙) to unlock ELITE.', 'warning'); return; }
            const cost = 1000;
            try {
                await updateCoins(currentUser.uid, -cost, 'ELITE upgrade');
                const partRef = doc(db, 'rooms', roomId, 'participants', currentUser.uid);
                await updateDoc(partRef, { elite: true });
                isElite = true;
                eliteTag.classList.add('show');
                coinBalance = await getCoins(currentUser.uid);
                coinEl.textContent = coinBalance;
                document.getElementById('sendCoinsBalance').textContent = coinBalance;
                if (roomData.createdBy) {
                    await updateCoins(roomData.createdBy, Math.floor(cost * 0.3), 'ELITE cut');
                }
                achievements.push('ELITE Elite');
                showToast('🔥 You are now ELITE! 🔥', 'elite', 'ELITE');
                addNotification('Upgraded to ELITE 🔥', 'elite', 'Upgrade');
                await addDoc(collection(db, 'rooms', roomId, 'messages'), {
