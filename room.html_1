        // ============================================================
        // TIER LOCK UI
        // ============================================================
        function updateTierLocks() {
            const vip = isVIP || isPremium || isElite;
            const premium = isPremium || isElite;
            const elite = isElite;

            document.getElementById('stickerLock').style.display = vip ? 'none' : 'flex';
            document.getElementById('voiceLock').style.display = premium ? 'none' : 'flex';
            document.getElementById('imageLock').style.display = elite ? 'none' : 'flex';
            // pollLock removed

            document.getElementById('typingStickerLock').style.display = vip ? 'none' : 'flex';
            document.getElementById('typingVoiceLock').style.display = premium ? 'none' : 'flex';
            document.getElementById('typingImageLock').style.display = elite ? 'none' : 'flex';
            // typingPollLock removed

            msgCostBadge.textContent = COSTS.text;
            typingCostBadge.textContent = COSTS.text;

            vipTag.classList.toggle('show', isVIP);
            premiumTag.classList.toggle('show', isPremium);
            eliteTag.classList.toggle('show', isElite);
        }

        // ============================================================
        // SEARCH
        // ============================================================
        window.toggleSearch = function() {
            searchMode = !searchMode;
            searchBar.classList.toggle('open', searchMode);
            if (searchMode) { searchInput.focus(); } else {
                searchInput.value = '';
                if (container._lastSnapshot) renderMessages(container._lastSnapshot);
            }
        };

        window.performSearch = function(query) {
            if (!query.trim()) {
                if (container._lastSnapshot) renderMessages(container._lastSnapshot);
                return;
            }
            const q = query.toLowerCase();
            const msgs = [];
            if (container._lastSnapshot) {
                container._lastSnapshot.forEach(d => {
                    const data = d.data();
                    if (data.text && data.text.toLowerCase().includes(q)) {
                        msgs.push({ id: d.id, ...data });
                    }
                });
            }
            if (msgs.length === 0) {
                container.innerHTML =
                    `<div class="empty-state"><span class="icon">🔍</span>No messages found for "${query}"</div>`;
                return;
            }
            let html = '';
            msgs.forEach(data => {
                html += buildMessageHTML(data, data.senderId === currentUser?.uid);
            });
            container.innerHTML = html;
        };

        // ============================================================
        // MORE DROPDOWN
        // ============================================================
        window.toggleMoreDropdown = function() {
            moreDropdown.classList.toggle('open');
        };

        window.closeMoreDropdown = function() {
            moreDropdown.classList.remove('open');
        };

        document.addEventListener('click', function(e) {
            if (!e.target.closest('#moreBtn') && !e.target.closest('#moreDropdown')) {
                moreDropdown.classList.remove('open');
            }
        });

        // ============================================================
        // CENTERED TYPING OVERLAY
        // ============================================================
        let isTypingOverlayOpen = false;

        function openTypingOverlay() {
            if (isTypingOverlayOpen) return;
            isTypingOverlayOpen = true;
            typingTextarea.value = msgInput.value;
            typingTextarea.focus();
            updateCharCount();
            typingOverlay.classList.add('open');
            bottomInputArea.style.display = 'none';
            document.body.style.overflow = 'hidden';
            typingCostBadge.textContent = COSTS.text;
        }

        window.closeTypingOverlay = function() {
            if (!isTypingOverlayOpen) return;
            isTypingOverlayOpen = false;
            msgInput.value = typingTextarea.value;
            typingOverlay.classList.remove('open');
            bottomInputArea.style.display = 'flex';
            document.body.style.overflow = '';
            msgInput.blur();
            typingTextarea.value = '';
            updateCharCount();
        };

        function updateCharCount() {
            charCount.textContent = typingTextarea.value.length;
        }
        typingTextarea.addEventListener('input', updateCharCount);

        msgInput.addEventListener('focus', function() {
            if (!hasPaid || this.disabled) return;
            if (isTypingOverlayOpen) return;
            openTypingOverlay();
        });

        inputWrapper.addEventListener('click', function(e) {
            if (e.target.tagName !== 'INPUT' && e.target.closest('.input-icon') === null) {
                if (hasPaid && !msgInput.disabled) {
                    msgInput.focus();
                }
            }
        });

        window.sendMessageFromOverlay = async function() {
            const text = typingTextarea.value.trim();
            if (!text || !hasPaid || !currentUser) return;
            closeTypingOverlay();
            msgInput.value = text;
            await window.sendMessage();
            msgInput.value = '';
        };

        const originalSend = window.sendMessage;
        window.sendMessage = async function() {
            if (isTypingOverlayOpen) {
                msgInput.value = typingTextarea.value;
                closeTypingOverlay();
            }
            await originalSend.call(this);
        };

        typingTextarea.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
                e.preventDefault();
                sendMessageFromOverlay();
            }
            if (e.key === 'Escape') {
                e.preventDefault();
                closeTypingOverlay();
            }
        });

        typingOverlay.addEventListener('click', function(e) {
            if (e.target === this) {
                closeTypingOverlay();
            }
        });

        function insertMentionOverlay() {
            const cursorPos = typingTextarea.selectionStart;
            const text = typingTextarea.value;
            typingTextarea.value = text.substring(0, cursorPos) + '@' + text.substring(cursorPos);
            typingTextarea.focus();
            typingTextarea.setSelectionRange(cursorPos + 1, cursorPos + 1);
            updateCharCount();
        }
        window.insertMentionOverlay = insertMentionOverlay;

        // ============================================================
        // STICKER PICKER
        // ============================================================
        window.toggleStickerPicker = function() {
            if (!isVIP && !isPremium && !isElite) {
                showToast('Upgrade to VIP to use stickers (2🪙 each)', 'warning', 'Stickers Locked');
                return;
            }
            const overlay = document.getElementById('stickerPickerOverlay');
            overlay.classList.toggle('open');
            if (overlay.classList.contains('open')) renderStickers('all');
        };

        window.closeStickerPicker = function() {
            document.getElementById('stickerPickerOverlay').classList.remove('open');
        };

        function renderStickers(category) {
            const grid = document.getElementById('stickerGrid');
            let emojis = category === 'all' ? allStickers : (stickers[category] || []);
            grid.innerHTML = emojis.map(e => `<button onclick="sendSticker('${e}')">${e}</button>`).join('');
        }

        window.switchStickerCategory = function(cat) {
            document.querySelectorAll('#stickerCategories button').forEach(b => b.classList.remove('active'));
            document.querySelector(`#stickerCategories button[data-cat="${cat}"]`).classList.add('active');
            renderStickers(cat);
        };

        window.sendSticker = function(emoji) {
            if (!isVIP && !isPremium && !isElite) {
                showToast('Upgrade to VIP to send stickers', 'warning', 'Stickers Locked');
                return;
            }
            closeStickerPicker();
            sendMessageWithType('sticker', emoji, COSTS.sticker);
        };

        // ============================================================
        // VOICE RECORDER
        // ============================================================
        let mediaRecorder = null;
        let audioChunks = [];
        let isRecording = false;

        window.toggleVoiceRecorder = function() {
            if (!isPremium && !isElite) {
                showToast('Upgrade to Premium to record voice notes (3🪙)', 'warning', 'Voice Locked');
                return;
            }
            if (isRecording) { stopRecording(); } else { startRecording(); }
        };

        async function startRecording() {
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                mediaRecorder = new MediaRecorder(stream);
                audioChunks = [];
                mediaRecorder.ondataavailable = event => { if (event.data.size > 0) audioChunks.push(event.data); };
                mediaRecorder.onstop = async () => {
                    const audioBlob = new Blob(audioChunks, { type: 'audio/webm' });
                    if (audioBlob.size > 0) {
                        await sendMessageWithType('voice', '🎤 Voice note (audio recording)', COSTS.voice);
                        showToast('Voice note sent -3🪙', 'success');
                        addNotification('Voice note sent', 'info', 'Voice');
                    }
                    stream.getTracks().forEach(track => track.stop());
                    isRecording = false;
                };
                mediaRecorder.start();
                isRecording = true;
                showToast('Recording… tap again to stop', 'info');
            } catch (e) {
                showToast('Could not access microphone', 'error');
                console.error(e);
            }
        }

        function stopRecording() {
            if (mediaRecorder && isRecording) { mediaRecorder.stop();
                isRecording = false; }
        }

        // ============================================================
        // IMAGE SHARING
        // ============================================================
        window.triggerImageUpload = function() {
            if (!isElite) {
                showToast('Upgrade to Elite to share images (5🪙)', 'warning', 'Image Sharing Locked');
                return;
            }
            document.getElementById('imageInput').click();
        };

        window.handleImageUpload = async function(event) {
            const file = event.target.files[0];
            if (!file) return;
            if (!isElite) { showToast('Upgrade to Elite to share images', 'warning', 'Image Sharing Locked'); return; }
            if (!file.type.startsWith('image/')) { showToast('Please select an image file', 'error'); return; }
            if (file.size > 5 * 1024 * 1024) { showToast('Image too large (max 5MB)', 'error'); return; }
            const reader = new FileReader();
            reader.onload = async function(e) {
                await sendMessageWithType('image', e.target.result, COSTS.image);
                showToast('Image sent -5🪙', 'success');
                addNotification('Image shared', 'info', 'Image');
            };
            reader.readAsDataURL(file);
            document.getElementById('imageInput').value = '';
        };

        // ============================================================
        // REACTION PICKER
        // ============================================================
        let reactionTargetId = null;

        window.openReactionPicker = function(messageId) {
            reactionTargetId = messageId;
            document.getElementById('reactionPickerOverlay').classList.add('open');
        };

        window.closeReactionPicker = function() {
            document.getElementById('reactionPickerOverlay').classList.remove('open');
            reactionTargetId = null;
        };

        window.addReaction = async function(emoji) {
            if (!reactionTargetId || !currentUser) return;
            const msgRef = doc(db, 'rooms', roomId, 'messages', reactionTargetId);
            try {
                const snap = await getDoc(msgRef);
                if (!snap.exists()) return;
                const data = snap.data();
                const reactions = data.reactions || {};
                const users = reactions[emoji] || [];
                const idx = users.indexOf(currentUser.uid);
                if (idx > -1) { users.splice(idx, 1); } else { users.push(currentUser.uid); }
                reactions[emoji] = users;
                await updateDoc(msgRef, { reactions });
                closeReactionPicker();
            } catch (e) { console.error('Reaction error:', e); }
        };

        // ============================================================
        // SEND MESSAGE (core)
        // ============================================================
        window.sendMessage = async function() {
            if (isTypingOverlayOpen) {
                msgInput.value = typingTextarea.value;
                closeTypingOverlay();
                if (!msgInput.value.trim()) return;
            }

            const text = msgInput.value.trim();
            if (!text || !hasPaid || !currentUser) return;

            const match = text.match(/^SP:([^/]+)\/(\d+)$/);
            if (match) {
                const spId = match[1].trim();
                const amount = parseInt(match[2]);
                if (amount > 0) {
                    const success = await sendCoinsViaSP(spId, amount);
                    if (success) { msgInput.value = '';
                        msgInput.focus(); }
                    return;
                } else {
                    showToast('Amount must be a positive number.', 'warning');
                    return;
                }
            }

            if (!await deductCoinsIfPossible(COSTS.text, 'Text message')) return;

            sendBtn.disabled = true;
            try {
                const msgData = {
                    senderId: currentUser.uid,
                    senderName: currentUser.displayName || 'User',
                    text: text,
                    type: 'text',
                    isVIP,
                    isPremium,
                    isElite,
                    isMod: isModerator,
                    achievements: achievements.slice(0, 2),
                    timestamp: serverTimestamp(),
                    reactions: {}
                };
                if (replyingTo) { msgData.replyTo = replyingTo;
                    replyingTo = null; }
                await addDoc(collection(db, 'rooms', roomId, 'messages'), msgData);
                msgInput.value = '';
                msgInput.focus();
                lastActivity = Date.now();
                await updateDoc(doc(db, 'rooms', roomId, 'participants', currentUser.uid), { lastActive: serverTimestamp() })
                    .catch(() => {});
            } catch (err) {
                showToast('Failed to send', 'error');
            }
            sendBtn.disabled = false;
        };

        async function sendMessageWithType(type, content, cost = 0) {
            if (!hasPaid || !currentUser) return;
            if (cost > 0 && !await deductCoinsIfPossible(cost, `${type} message`)) return;

            sendBtn.disabled = true;
            try {
                const msgData = {
                    senderId: currentUser.uid,
                    senderName: currentUser.displayName || 'User',
                    text: content,
                    type: type,
                    isVIP,
                    isPremium,
                    isElite,
                    isMod: isModerator,
                    achievements: achievements.slice(0, 2),
                    timestamp: serverTimestamp(),
                    reactions: {}
                };
                if (replyingTo) { msgData.replyTo = replyingTo;
                    replyingTo = null; }
                await addDoc(collection(db, 'rooms', roomId, 'messages'), msgData);
                lastActivity = Date.now();
            } catch (err) {
                showToast('Failed to send', 'error');
            }
            sendBtn.disabled = false;
        }

        // ============================================================
        // MESSAGE ACTIONS
        // ============================================================
        window.editMessage = async function(messageId) {
            if (!currentUser) return;
            const msgRef = doc(db, 'rooms', roomId, 'messages', messageId);
            const snap = await getDoc(msgRef);
            if (!snap.exists()) return;
            const data = snap.data();
            if (data.senderId !== currentUser.uid) { showToast('Not your message', 'error'); return; }
            const msgTime = data.timestamp?.toDate?.() || new Date();
            if (Date.now() - msgTime.getTime() > 300000) {
                showToast('Edit window expired (5 minutes)', 'warning');
                return;
            }
            const newText = prompt('Edit your message:', data.text);
            if (newText === null || newText.trim() === '') return;
            try {
                await updateDoc(msgRef, { text: newText.trim(), edited: true, editedAt: serverTimestamp() });
                showToast('Message updated', 'success');
            } catch (e) { showToast('Failed to edit', 'error'); }
        };

        window.deleteMessage = async function(messageId) {
            if (!currentUser) return;
            const msgRef = doc(db, 'rooms', roomId, 'messages', messageId);
            const snap = await getDoc(msgRef);
            if (!snap.exists()) return;
            const data = snap.data();
            if (data.senderId !== currentUser.uid && !isModerator && !isRoomOwner) {
                showToast('Not allowed', 'error');
                return;
            }
            if (data.senderId === currentUser.uid) {
                const msgTime = data.timestamp?.toDate?.() || new Date();
                if (Date.now() - msgTime.getTime() > 300000 && !isModerator && !isRoomOwner) {
                    showToast('Delete window expired (5 minutes)', 'warning');
                    return;
                }
            }
            const ok = await showConfirm({
                icon: '🗑️',
                title: 'Delete Message?',
                message: 'This action cannot be undone.',
                confirmText: 'Delete',
                confirmType: 'danger'
            });
            if (!ok) return;
            try {
                await deleteDoc(msgRef);
                showToast('Message deleted', 'success');
            } catch (e) { showToast('Failed to delete', 'error'); }
        };

        window.replyToMessage = function(messageId) {
            replyingTo = messageId;
            msgInput.focus();
            msgInput.placeholder = 'Reply to message…';
            showToast('Reply mode active. Type your reply.', 'info');
        };

        window.cancelReply = function() {
            replyingTo = null;
            msgInput.placeholder = 'Type a message… (1🪙)';
        };

        window.pinMessage = async function(messageId) {
            if (!isElite && !isModerator && !isRoomOwner) {
                showToast('Upgrade to Elite to pin messages', 'warning', 'Pin Locked');
                return;
            }
            const msgRef = doc(db, 'rooms', roomId, 'messages', messageId);
            const snap = await getDoc(msgRef);
            if (!snap.exists()) return;
            const data = snap.data();
            if (!isModerator && !isRoomOwner && data.senderId !== currentUser.uid) {
                showToast('You can only pin your own messages', 'error');
                return;
            }
            try {
                await updateDoc(msgRef, { pinned: true });
                showToast('Message pinned!', 'success');
                addNotification('Pinned a message', 'info', 'Pin');
            } catch (e) { showToast('Failed to pin', 'error'); }
        };

        window.unpinMessage = async function(messageId) {
            if (!isModerator && !isRoomOwner && !isElite) {
                showToast('Not allowed', 'error');
                return;
            }
            try {
                await updateDoc(doc(db, 'rooms', roomId, 'messages', messageId), { pinned: false });
                showToast('Message unpinned', 'success');
            } catch (e) { showToast('Failed to unpin', 'error'); }
        };

        // ============================================================
        // BUILD MESSAGE HTML
        // ============================================================
        function buildMessageHTML(data, isSelf) {
            const time = data.timestamp?.toDate ? data.timestamp.toDate() : new Date();
            const timeStr = time.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

            if (data.type === 'system') {
                return `<div class="system-msg">${data.text}</div>`;
            }

            let senderName = data.senderName || 'User';
            let crown = data.isVIP ? '<span class="crown">👑</span>' : '';
            let premiumBadge = data.isPremium ? '<span class="premium-badge-sender">⭐</span>' : '';
            let eliteBadge = data.isElite ? '<span class="elite-badge-sender">🔥</span>' : '';
            let modTag = data.isMod ? '<span class="mod-tag">MOD</span>' : '';
            let achTags = '';
            if (data.achievements && data.achievements.length) {
                achTags = data.achievements.slice(0, 2).map(a => `<span class="ach-tag">🏅${a}</span>`).join('');
            }
            let vipClass = data.isVIP ? 'vip' : '';
            let premiumClass = data.isPremium ? 'premium' : '';
            let eliteClass = data.isElite ? 'elite' : '';
            let msgClass = isSelf ? 'self' : 'other';
            let content = '';

            let replyHTML = '';
            if (data.replyTo) {
                replyHTML =
                    `<div class="reply-preview" onclick="scrollToMessage('${data.replyTo}')">↩️ <span class="reply-author">Replying to</span> <span class="reply-text">[original message]</span></div>`;
            }

            if (data.type === 'gift') {
                content =
                    `<div class="gift-emoji">${escapeHTML(data.text)}</div><div class="gift-label">🎁 Gift</div><div class="gift-from">from ${escapeHTML(senderName)}</div>`;
                msgClass += ' gift';
            } else if (data.type === 'sticker') {
                content = `<div class="sticker">${data.text}</div>`;
            } else if (data.type === 'image') {
                content =
                    `<img src="${data.text}" class="msg-image" onclick="openLightbox('${data.text}')" loading="lazy">`;
            } else if (data.type === 'voice') {
                content =
                    `<div class="voice-msg"><button>▶</button><div class="wave"><div class="fill" style="width:60%;"></div></div><span class="duration">0:30</span></div>`;
            } else {
                // text
                let text = escapeHTML(data.text || '');
                text = text.replace(/@(\w+)/g, '<span class="mention">@$1</span>');
                text = text.replace(/#(\w+)/g, '<span class="hashtag">#$1</span>');
                content = `<div class="text">${text}</div>`;
            }

            let reactionsHTML = '';
            const reactions = data.reactions || {};
            const reactionEmojis = Object.keys(reactions);
            if (reactionEmojis.length > 0) {
                reactionsHTML = `<div class="reactions">`;
                reactionEmojis.forEach(emoji => {
                    const users = reactions[emoji] || [];
                    const count = users.length;
                    const active = currentUser && users.includes(currentUser.uid);
                    reactionsHTML +=
                        `<span class="reaction ${active ? 'active' : ''}" onclick="addReactionToMessage('${data.id}', '${emoji}')">${emoji} <span class="r-count">${count}</span></span>`;
                });
                reactionsHTML += `</div>`;
            }

            let pinnedBadge = data.pinned ? '<span class="pinned-badge">📌 Pinned</span>' : '';

            let actionsHTML = '';
            if (isSelf || isModerator || isRoomOwner) {
                actionsHTML = `<div class="msg-actions">`;
                if (isSelf) actionsHTML += `<button onclick="editMessage('${data.id}')">✏️</button>`;
                actionsHTML += `<button onclick="replyToMessage('${data.id}')">↩️</button>`;
                if (isSelf || isModerator || isRoomOwner) {
                    actionsHTML += `<button class="danger" onclick="deleteMessage('${data.id}')">🗑️</button>`;
                }
                if (isModerator || isRoomOwner || (isElite && isSelf)) {
                    if (data.pinned) {
                        actionsHTML += `<button onclick="unpinMessage('${data.id}')">📌 Unpin</button>`;
                    } else {
                        actionsHTML += `<button onclick="pinMessage('${data.id}')">📌 Pin</button>`;
                    }
                }
                actionsHTML += `<button onclick="openReactionPicker('${data.id}')">😊</button>`;
                actionsHTML += `</div>`;
            } else {
                actionsHTML =
                    `<div class="msg-actions"><button onclick="replyToMessage('${data.id}')">↩️</button><button onclick="openReactionPicker('${data.id}')">😊</button></div>`;
            }

            return `
                    <div class="msg ${msgClass} ${vipClass} ${premiumClass} ${eliteClass}" id="msg-${data.id}">
                        ${replyHTML}
                        <div class="sender">
                            ${crown} ${premiumBadge} ${eliteBadge} ${senderName} ${modTag} ${achTags} ${pinnedBadge}
                        </div>
                        ${content}
                        ${reactionsHTML}
                        <div class="time">
                            ${timeStr} ${data.edited ? '✎' : ''}
                            ${actionsHTML}
                        </div>
                    </div>
                `;
        }

        function escapeHTML(s) {
            return String(s || '').replace(/[&<>'"]/g, t => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;',
                '"': '&quot;' } [t] || t));
        }

        // ============================================================
        // ADD REACTION
        // ============================================================
        window.addReactionToMessage = async function(messageId, emoji) {
            if (!currentUser) return;
            const msgRef = doc(db, 'rooms', roomId, 'messages', messageId);
            try {
                const snap = await getDoc(msgRef);
                if (!snap.exists()) return;
                const data = snap.data();
                const reactions = data.reactions || {};
                const users = reactions[emoji] || [];
                const idx = users.indexOf(currentUser.uid);
                if (idx > -1) { users.splice(idx, 1); } else { users.push(currentUser.uid); }
                reactions[emoji] = users;
                await updateDoc(msgRef, { reactions });
            } catch (e) { console.error('Reaction error:', e); }
        };

        // ============================================================
        // RENDER MESSAGES
        // ============================================================
        function renderMessages(snapshot) {
            container._lastSnapshot = snapshot;
            if (searchMode && searchInput.value.trim()) {
                performSearch(searchInput.value);
                return;
            }
            let html = '';
            let hasMsg = false;
            const msgs = [];
            snapshot.forEach(d => msgs.push({ id: d.id, ...d.data() }));

            if (!msgs.length) {
                container.innerHTML =
                    `<div class="empty-state"><span class="icon">💬</span>No messages yet.<br />Say hello!</div>`;
                return;
            }

            msgs.sort((a, b) => {
                const ta = a.timestamp?.toDate ? a.timestamp.toDate() : new Date(0);
                const tb = b.timestamp?.toDate ? b.timestamp.toDate() : new Date(0);
                return ta - tb;
            });

            for (const data of msgs) {
                hasMsg = true;
                const isSelf = data.senderId === currentUser?.uid;
                html += buildMessageHTML(data, isSelf);
            }

            if (!hasMsg) {
                html = `<div class="empty-state"><span class="icon">💬</span>No messages yet.<br />Say hello!</div>`;
            }

            container.innerHTML = html;
            container.scrollTop = container.scrollHeight;
        }

        // ============================================================
        // PARTICIPANTS
        // ============================================================
        window.toggleParticipants = function() {
            const panel = document.getElementById('participantsPanel');
            const overlay = document.getElementById('participantsOverlay');
            panel.classList.toggle('open');
            overlay.classList.toggle('open');
            if (panel.classList.contains('open')) loadParticipants();
        };

        async function loadParticipants() {
            const list = document.getElementById('participantsList');
            try {
                const snap = await getDocs(collection(db, 'rooms', roomId, 'participants'));
                if (snap.empty) { list.innerHTML = '<div class="empty-participants">No one here</div>'; return; }
                let html = '';
                const uids = [];
                snap.forEach(d => { uids.push({ uid: d.id, data: d.data() }); });
                for (const { uid, data } of uids) {
                    let name = 'User',
                        avatar = '',
                        online = false;
                    let signalAmount = 0,
                        signalActive = false;
                    try {
                        const s = await getDoc(doc(db, 'users', uid));
                        if (s.exists()) {
                            const d = s.data();
                            name = d.name || d.displayName || 'User';
                            avatar = d.avatar || '';
                            online = d.onlineStatus === true;
                            signalActive = d.signalActive === true;
                            signalAmount = d.signalAmount || 0;
                        }
                    } catch (e) {}
                    const isVip = data.vip === true;
                    const isPremiumP = data.premium === true;
                    const isEliteP = data.elite === true;
                    const isMod = data.moderator === true;
                    const avatarHTML = avatar ? `<img src="${avatar}">` : name.charAt(0).toUpperCase();
                    const crown = isVip ? '<span class="crown">👑</span>' : '';
                    const premiumBadgeP = isPremiumP ? '<span class="premium-badge-p">⭐</span>' : '';
                    const eliteBadgeP = isEliteP ? '<span class="elite-badge-p">🔥</span>' : '';
                    const signalBadge = signalActive ? `<span class="signal-badge">📡 ${signalAmount}🪙</span>` : '';
                    const modBadge = isMod ? '<span class="mod-badge">MOD</span>' : '';
                    const onlineDot = online ? '<span class="online-dot on"></span>' : '<span class="online-dot off"></span>';
                    const isSelf = uid === currentUser?.uid;
                    html += `
                            <div class="participant" data-uid="${uid}" onclick="showUserMenu('${uid}', event)">
                                <div class="avatar">${avatarHTML}</div>
                                <div class="info">
                                    <div class="name">${crown} ${premiumBadgeP} ${eliteBadgeP} ${name} ${signalBadge} ${modBadge} ${isSelf ? ' (you)' : ''}</div>
                                    <div class="status">${onlineDot} ${online ? 'Online' : 'Offline'}</div>
                                </div>
                            </div>
                        `;
                }
                list.innerHTML = html || '<div class="empty-participants">No one here</div>';
                const count = uids.length;
                memberBadge.textContent = count;
                moreMemberBadge.textContent = count;
                memberCountEl.textContent = count;
                roomMembersEl.textContent = `👥 ${count}`;
            } catch (e) {
                list.innerHTML = '<div class="empty-participants">Failed to load</div>';
            }
        }

        // ============================================================
        // PROFILE MODAL
        // ============================================================
        let profileSignalUnsub = null;

        window.openProfileModal = async function(uid) {
            if (currentUser && uid === currentUser.uid) {
                window.location.href = 'profile.html';
                return;
            }
            closeProfileModal();

            profileModalOverlay.classList.add('open');
            profileModalBody.innerHTML =
                `<div class="profile-loader" style="text-align:center;padding:20px;color:var(--text-muted);">Loading…</div>`;

            try {
                const userDoc = await getDoc(doc(db, 'users', uid));
                if (!userDoc.exists()) {
                    profileModalBody.innerHTML =
                        `<div style="text-align:center;padding:20px;color:var(--error);">User not found</div>`;
                    return;
                }
                const data = userDoc.data();
                const name = data.name || data.displayName || 'User';
                const spId = data.spId || 'N/A';
                const avatar = data.avatar || '';
                const avatarHTML = avatar ? `<img src="${avatar}">` : escapeHTML(name.charAt(0).toUpperCase());
                const signalActive = data.signalActive === true;
                const signalAmount = data.signalAmount || 0;

                let signalHTML = '';
                if (signalActive) {
                    signalHTML =
                        `<div class="profile-signal">📡 Signal: <span class="signal-amount">${signalAmount}</span> 🪙</div>`;
                } else {
                    signalHTML =
                        `<div class="profile-signal" style="border-color:var(--border-color);color:var(--text-muted);">No active signal</div>`;
                }

                profileModalBody.innerHTML = `
                        <div class="profile-avatar">${avatarHTML}</div>
                        <div class="profile-name">${escapeHTML(name)}</div>
                        <div class="profile-spid">SP ID: ${escapeHTML(spId)}</div>
                        ${signalHTML}
                        <div class="profile-actions">
                            ${signalActive ? `<button class="btn-send-coins" onclick="sendSignalCoins('${escapeHTML(uid)}', ${signalAmount})">📤 Send ${signalAmount} coins</button>` : ''}
                            <button class="btn-send-gift" onclick="openGiftSendModal('${escapeHTML(uid)}')">🎁 Send Gift</button>
                            <button class="btn-message" onclick="window.location.href='chat.html?uid=${uid}'">💬 Message</button>
                            <button class="btn-close" onclick="closeProfileModal()">Close</button>
                        </div>
                    `;

                if (profileSignalUnsub) profileSignalUnsub();
                profileSignalUnsub = onSnapshot(doc(db, 'users', uid), (snap) => {
                    if (snap.exists()) {
                        const newData = snap.data();
                        const newSignalActive = newData.signalActive === true;
                        const newSignalAmount = newData.signalAmount || 0;
                        const signalDiv = profileModalBody.querySelector('.profile-signal');
                        const actionsDiv = profileModalBody.querySelector('.profile-actions');
                        if (signalDiv) {
                            if (newSignalActive) {
                                signalDiv.innerHTML =
                                    `📡 Signal: <span class="signal-amount">${newSignalAmount}</span> 🪙`;
                                signalDiv.style.borderColor = 'rgba(255,215,0,0.12)';
                                signalDiv.style.color = 'var(--gold)';
                                const existingBtn = actionsDiv?.querySelector('.btn-send-coins');
                                if (existingBtn) {
                                    existingBtn.textContent = `📤 Send ${newSignalAmount} coins`;
                                    existingBtn.setAttribute('onclick', `sendSignalCoins('${uid}', ${newSignalAmount})`);
                                } else {
                                    const btn = document.createElement('button');
                                    btn.className = 'btn-send-coins';
                                    btn.textContent = `📤 Send ${newSignalAmount} coins`;
                                    btn.onclick = () => sendSignalCoins(uid, newSignalAmount);
                                    actionsDiv?.prepend(btn);
                                }
                            } else {
                                signalDiv.innerHTML = 'No active signal';
                                signalDiv.style.borderColor = 'var(--border-color)';
                                signalDiv.style.color = 'var(--text-muted)';
                                const btn = actionsDiv?.querySelector('.btn-send-coins');
                                if (btn) btn.remove();
                            }
                        }
                    }
                }, (err) => console.error('Signal listener error:', err));

            } catch (e) {
                console.error('Profile modal error:', e);
                profileModalBody.innerHTML =
                    `<div style="text-align:center;padding:20px;color:var(--error);">Failed to load profile</div>`;
            }
        };

        window.closeProfileModal = function() {
            if (profileSignalUnsub) { profileSignalUnsub();
                profileSignalUnsub = null; }
            profileModalOverlay.classList.remove('open');
            profileModalBody.innerHTML = '';
        };

        window.sendSignalCoins = async function(uid, amount) {
            if (!currentUser) { showToast('Please sign in to send coins.', 'warning'); return; }
            if (amount <= 0) { showToast('Signal amount must be positive.', 'warning'); return; }
            if (amount > coinBalance) { showToast(`You only have ${coinBalance} 🪙.`, 'error'); return; }
            if (!confirm(`Send ${amount} coins to this user?`)) return;

            const recipientDoc = await getDoc(doc(db, 'users', uid));
            if (!recipientDoc.exists()) { showToast('User not found.', 'error'); return; }
            const spId = recipientDoc.data().spId;
            if (!spId) { showToast('Recipient has no SPIKE ID.', 'error'); return; }
            const success = await sendCoinsViaSP(spId, amount);
            if (success) closeProfileModal();
        };

        // ============================================================
        // USER MENU
        // ============================================================
        window.showUserMenu = function(uid, event) {
            event.stopPropagation();
            selectedUserUid = uid;
            const menu = document.getElementById('userMenu');
            const overlay = document.getElementById('userMenuOverlay');
            const x = event.clientX || event.pageX || 0;
            const y = event.clientY || event.pageY || 0;
            const w = window.innerWidth,
                h = window.innerHeight;
            let left = x,
                top = y;
            if (left + 170 > w) left = w - 170;
            if (top + 200 > h) top = h - 200;
            if (left < 10) left = 10;
            if (top < 10) top = 10;
            menu.style.left = left + 'px';
            menu.style.top = top + 'px';
            menu.style.display = 'block';
            overlay.classList.add('active');

            const kickBtn = document.getElementById('menuKick');
            const muteBtn = document.getElementById('menuMute');
            const waiveBtn = document.getElementById('menuWaiveFee');
            if (isRoomOwner || isModerator) {
                kickBtn.style.display = 'flex';
                muteBtn.style.display = 'flex';
                waiveBtn.style.display = isRoomOwner ? 'flex' : 'none';
            } else {
                kickBtn.style.display = 'none';
                muteBtn.style.display = 'none';
                waiveBtn.style.display = 'none';
            }

            document.getElementById('menuViewProfile').onclick = () => { closeUserMenu();
                window.openProfileModal(uid); };
            document.getElementById('menuSendCoins').onclick = () => { closeUserMenu();
                openSendCoinsModal(); };
            document.getElementById('menuPrivateMsg').onclick = () => { closeUserMenu();
                window.location.href = `chat.html?uid=${uid}`; };
            document.getElementById('menuSendGift').onclick = () => { closeUserMenu();
                window.openGiftSendModal(uid); };
            document.getElementById('menuReport').onclick = () => { closeUserMenu();
                reportUser(uid); };
            document.getElementById('menuKick').onclick = () => { closeUserMenu();
                kickUserByUid(uid); };
            document.getElementById('menuMute').onclick = () => { closeUserMenu();
                muteUser(uid); };
            document.getElementById('menuWaiveFee').onclick = () => { closeUserMenu();
                waiveFee(uid); };
        };

        window.closeUserMenu = function() {
            document.getElementById('userMenu').style.display = 'none';
            document.getElementById('userMenuOverlay').classList.remove('active');
            selectedUserUid = null;
        };

        async function reportUser(uid) {
            const reason = prompt('Why are you reporting this user?');
            if (!reason) return;
            await addDoc(collection(db, 'reports'), {
                reportedUid: uid,
                reportedBy: currentUser.uid,
                reason,
                status: 'pending',
                createdAt: serverTimestamp()
            });
            showToast('🚩 Report submitted', 'info');
            addNotification(`Reported user ${uid}`, 'warning', 'Report');
        }

        async function kickUserByUid(uid) {
            if (!isRoomOwner && !isModerator) { showToast('Not allowed', 'error'); return; }
            const ok = await showConfirm({
                icon: '👢',
                title: 'Kick User?',
                message: 'This user will be removed.',
                confirmText: 'Kick',
                confirmType: 'danger'
            });
            if (!ok) return;
            await deleteDoc(doc(db, 'rooms', roomId, 'participants', uid));
            await updateDoc(doc(db, 'rooms', roomId), { participantCount: increment(-1) });
            showToast('User kicked', 'warning');
            addNotification(`Kicked user ${uid}`, 'warning', 'Kick');
        }

        async function muteUser(uid) {
            if (!isRoomOwner && !isModerator) { showToast('Not allowed', 'error'); return; }
            const ref = doc(db, 'rooms', roomId, 'participants', uid);
            await updateDoc(ref, { muted: true });
            showToast('User muted', 'warning');
            addNotification(`Muted user ${uid}`, 'warning', 'Mute');
        }

        async function waiveFee(uid) {
            if (!isRoomOwner) { showToast('Only owner can waive fees', 'error'); return; }
            await setDoc(doc(db, 'rooms', roomId, 'participants', uid), { feeWaived: true }, { merge: true });
            showToast('Fee waived for user', 'success');
            addNotification(`Waived fee for ${uid}`, 'info', 'Fee Waived');
        }

        // ============================================================
        // INSERT MENTION
        // ============================================================
        window.insertMention = function() {
            const input = msgInput;
            const cursorPos = input.selectionStart;
            const text = input.value;
            input.value = text.substring(0, cursorPos) + '@' + text.substring(cursorPos);
            input.focus();
            input.setSelectionRange(cursorPos + 1, cursorPos + 1);
        };

        // ============================================================
        // LIGHTBOX
        // ============================================================
        window.openLightbox = function(url) {
            window.open(url, '_blank');
        };

        // ============================================================
        // JOIN ROOM
        // ============================================================
        async function joinRoom(uid, rid) {
            try {
                const roomRef = doc(db, 'rooms', rid);
                const roomSnap = await getDoc(roomRef);
                if (!roomSnap.exists()) { showToast('Room not found', 'error'); return false; }
                roomData = roomSnap.data();
                roomNameEl.textContent = (roomData.name || 'Room') + ' 🔥';
                const fee = roomData.entryFee || 50;
                isRoomOwner = roomData.createdBy === uid;

                if (isRoomOwner) {
                    hasPaid = true;
                    isModerator = true;
                    isElite = true;
                    roomFeeEl.textContent = `🪙 ${fee} (free)`;
                    eliteTag.classList.add('show');
                    msgInput.disabled = false;
                    sendBtn.disabled = false;
                    showToast('👑 Owner mode activated', 'gold');
                    addNotification('Owner mode activated', 'gold', 'Owner');
                    updateTierLocks();
                    return true;
                }

                const partRef = doc(db, 'rooms', rid, 'participants', uid);
                const partSnap = await getDoc(partRef);
                if (partSnap.exists()) {
                    hasPaid = true;
                    const data = partSnap.data();
                    if (data.vip) { isVIP = true;
                        vipTag.classList.add('show'); }
                    if (data.premium) { isPremium = true;
                        premiumTag.classList.add('show'); }
                    if (data.elite) { isElite = true;
                        eliteTag.classList.add('show'); }
                    if (data.moderator) isModerator = true;
                    roomFeeEl.textContent = `🪙 ${fee} (paid)`;
                    msgInput.disabled = false;
                    sendBtn.disabled = false;
                    updateTierLocks();
                    return true;
                }

                await updateCoins(uid, -fee, `Joined room: ${roomData.name || rid}`);
                await setDoc(partRef, { joinedAt: serverTimestamp(), vip: false, premium: false, elite: false,
                    moderator: false });
                await updateDoc(roomRef, { participantCount: increment(1) });
                hasPaid = true;
                coinBalance = await getCoins(uid);
                coinEl.textContent = coinBalance;
                document.getElementById('sendCoinsBalance').textContent = coinBalance;
                roomFeeEl.textContent = `🪙 ${fee} (paid)`;
                msgInput.disabled = false;
                sendBtn.disabled = false;
                showToast(`🎉 Joined! -${fee} 🪙`, 'success');
                addNotification(`Joined room — paid ${fee}🪙`, 'success', 'Room Joined');
                startActivityTracker(uid);
                updateTierLocks();
                return true;
            } catch (err) {
                showToast(err.message || 'Failed to join', 'error');
                return false;
            }
        }

        function startActivityTracker(uid) {
            const updateActivity = () => {
                lastActivity = Date.now();
                if (roomId && uid) {
                    updateDoc(doc(db, 'rooms', roomId, 'participants', uid), { lastActive: serverTimestamp() }).catch(
                        () => {});
                }
            };
            document.addEventListener('click', updateActivity);
            document.addEventListener('keydown', updateActivity);
            setInterval(async () => {
                if (!hasPaid || !roomId) return;
                if ((Date.now() - lastActivity) > 300000) {
                    await deleteDoc(doc(db, 'rooms', roomId, 'participants', currentUser.uid));
                    await updateDoc(doc(db, 'rooms', roomId), { participantCount: increment(-1) });
                    showToast('⏰ Kicked for inactivity', 'warning');
                    addNotification('Kicked for inactivity', 'warning', 'Inactive');
                    setTimeout(() => window.location.href = 'rooms.html', 1500);
                }
            }, 30000);
        }

        // ============================================================
        // INIT
        // ============================================================
        async function init() {
            const urlParams = new URLSearchParams(window.location.search);
            roomId = urlParams.get('id');
            if (!roomId) { showToast('No room ID', 'error');
                setTimeout(() => window.location.href = 'rooms.html', 1500); return; }

            onAuthStateChanged(auth, async (user) => {
                if (!user) { window.location.href = 'index.html'; return; }
                currentUser = user;

                try {
                    const userDoc = await getDoc(doc(db, 'users', user.uid));
                    if (userDoc.exists()) {
                        const data = userDoc.data();
                        userSpId = data.spId || null;
                        if (data.achievements) achievements = data.achievements;
                    }
                } catch (e) {}

                const roomRef = doc(db, 'rooms', roomId);
                const roomSnap = await getDoc(roomRef);
                if (!roomSnap.exists()) { showToast('Room not found', 'error'); return; }
                roomData = roomSnap.data();
                roomNameEl.textContent = (roomData.name || 'Room') + ' 🔥';

                if (roomData.announcement) {
                    const lastMsgQuery = query(collection(db, 'rooms', roomId, 'messages'), orderBy('timestamp',
                        'desc'), limit(1));
                    const lastMsgSnap = await getDocs(lastMsgQuery);
                    let alreadyAdded = false;
                    lastMsgSnap.forEach(d => {
                        const data = d.data();
                        if (data.type === 'system' && data.text === `📢 ${roomData.announcement}`) {
                            alreadyAdded = true;
                        }
                    });
                    if (!alreadyAdded) {
                        await addDoc(collection(db, 'rooms', roomId, 'messages'), {
                            senderId: 'system',
                            senderName: 'SPIKE',
                            text: `📢 ${roomData.announcement}`,
                            type: 'system',
                            timestamp: serverTimestamp()
                        });
                    }
                }

                const joined = await joinRoom(user.uid, roomId);
                if (!joined) { setTimeout(() => window.location.href = 'rooms.html', 2000); return; }

                coinBalance = await getCoins(user.uid);
                coinEl.textContent = coinBalance;
                document.getElementById('sendCoinsBalance').textContent = coinBalance;

                const msgQ = query(collection(db, 'rooms', roomId, 'messages'), orderBy('timestamp', 'asc'), limit(
                    200));
                messageUnsub = onSnapshot(msgQ, renderMessages, err => showToast('Message error', 'error'));

                participantUnsub = onSnapshot(roomRef, (snap) => {
                    if (snap.exists()) {
                        const data = snap.data();
                        const count = data.participantCount || 0;
                        memberCountEl.textContent = count;
                        memberBadge.textContent = count;
                        moreMemberBadge.textContent = count;
                        roomMembersEl.textContent = `👥 ${count}`;
                        roomData = data;
                    }
                });

                setInterval(() => {
                    const online = navigator.onLine;
                    roomStatusDot.className = 'dot ' + (online ? 'online' : 'offline');
                    roomStatusText.textContent = online ? 'online' : 'offline';
                }, 10000);

                const today = new Date().toDateString();
                const streakKey = `streak_${roomId}_${user.uid}`;
                if (localStorage.getItem(streakKey) !== today) {
                    const bonus = isElite ? 8 : isPremium ? 5 : isVIP ? 4 : 2;
                    await updateCoins(user.uid, bonus, 'Daily room bonus');
                    localStorage.setItem(streakKey, today);
                    coinBalance = await getCoins(user.uid);
                    coinEl.textContent = coinBalance;
                    document.getElementById('sendCoinsBalance').textContent = coinBalance;
                    const tier = isElite ? 'ELITE (4x)' : isPremium ? 'Premium (2.5x)' : isVIP ? 'VIP (2x)' :
                        'normal';
                    showToast(`+${bonus} 🪙 daily bonus (${tier})`, 'success');
                    addNotification(`Daily bonus +${bonus}🪙 (${tier})`, 'gold', 'Daily Bonus');
                }

                container.scrollTop = container.scrollHeight;

                const typingRef = doc(db, 'rooms', roomId, 'typing', 'state');
                onSnapshot(typingRef, (snap) => {
                    if (snap.exists()) {
                        const data = snap.data();
                        const typer = data.uid;
                        if (typer && typer !== currentUser.uid) {
                            typingIndicator.textContent = `${data.name || 'Someone'} is typing…`;
                            typingIndicator.classList.add('active');
                            clearTimeout(typingIndicator._timeout);
                            typingIndicator._timeout = setTimeout(() => {
                                typingIndicator.classList.remove('active');
                            }, 3000);
                        } else {
                            typingIndicator.classList.remove('active');
                        }
                    }
                }, (err) => console.error('Typing listener error:', err));

                msgInput.addEventListener('input', () => {
                    if (msgInput.value.trim()) {
                        setDoc(typingRef, { uid: currentUser.uid, name: currentUser.displayName || 'User',
                            updatedAt: serverTimestamp() }, { merge: true });
                    }
                });
                msgInput.addEventListener('blur', () => {
                    setDoc(typingRef, { uid: null, updatedAt: serverTimestamp() }, { merge: true });
                });

                updateTierLocks();
                loadGiftBadgeCount();
                loadParticipants();

                addNotification('Welcome to the room! 🎉', 'info', 'Welcome');
            });
        }

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                if (document.getElementById('userMenu').style.display === 'block') closeUserMenu();
                else if (document.getElementById('premiumPanelOverlay').classList.contains('open')) closePremiumPanel();
                else if (document.getElementById('giftSendOverlay').classList.contains('open')) closeGiftSendModal();
                else if (document.getElementById('giftsPanelOverlay').classList.contains('open')) closeGiftsPanel();
                else if (document.getElementById('stickerPickerOverlay').classList.contains('open')) closeStickerPicker();
                else if (document.getElementById('reactionPickerOverlay').classList.contains('open')) closeReactionPicker();
                else if (document.getElementById('contactModalOverlay').classList.contains('open')) closeContactModal();
                else if (profileModalOverlay.classList.contains('open')) closeProfileModal();
                else if (document.getElementById('sendCoinsOverlay').classList.contains('open')) closeSendCoinsModal();
                else if (moreDropdown.classList.contains('open')) closeMoreDropdown();
                else if (isTypingOverlayOpen) closeTypingOverlay();
                else if (replyingTo) { cancelReply(); } else window.location.href = 'rooms.html';
            }
            if ((e.ctrlKey || e.metaKey) && e.key === 'p') { e.preventDefault();
                openPremiumPanel(); }
            if ((e.ctrlKey || e.metaKey) && e.key === 'f') { e.preventDefault();
                toggleSearch(); }
        });

        premiumPanelOverlay.addEventListener('click', function(e) {
            if (e.target === this) closePremiumPanel();
        });

        document.getElementById('contactModalOverlay').addEventListener('click', function(e) {
            if (e.target === this) closeContactModal();
        });
        profileModalOverlay.addEventListener('click', function(e) {
            if (e.target === this) closeProfileModal();
        });
        giftSendOverlay.addEventListener('click', function(e) {
            if (e.target === this) closeGiftSendModal();
        });
        giftsPanelOverlay.addEventListener('click', function(e) {
            if (e.target === this) closeGiftsPanel();
        });
        document.getElementById('sendCoinsOverlay').addEventListener('click', function(e) {
            if (e.target === this) closeSendCoinsModal();
        });
        document.getElementById('stickerPickerOverlay').addEventListener('click', function(e) {
            if (e.target === this) closeStickerPicker();
        });
        document.getElementById('reactionPickerOverlay').addEventListener('click', function(e) {
            if (e.target === this) closeReactionPicker();
        });

        init();

        console.log('🔥 SPIKE ELITE Room — Loaded successfully');
        console.log('💸 Send coins: SP:id/amount or modal');
        console.log('🎁 All users can send gifts');
        console.log('📬 All notifications appear in Premium Panel feed');
    </script>
</body>
</html>